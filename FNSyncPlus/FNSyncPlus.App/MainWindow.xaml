<Window x:Class="FNSyncPlus.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="飞牛同步增强版 (FN Sync Plus) - 长文件名无损兼容"
        Height="720" Width="1120"
        MinHeight="640" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9"
        FontFamily="Microsoft YaHei UI, Segoe UI, sans-serif">

    <Window.Resources>
        <!-- Modern Color Palette -->
        <SolidColorBrush x:Key="SidebarBg" Color="#0F172A"/>
        <SolidColorBrush x:Key="SidebarItemHover" Color="#1E293B"/>
        <SolidColorBrush x:Key="SidebarActive" Color="#0284C7"/>
        <SolidColorBrush x:Key="PrimaryColor" Color="#0284C7"/>
        <SolidColorBrush x:Key="PrimaryHover" Color="#0369A1"/>
        <SolidColorBrush x:Key="SuccessColor" Color="#10B981"/>
        <SolidColorBrush x:Key="WarningColor" Color="#F59E0B"/>
        <SolidColorBrush x:Key="DangerColor" Color="#EF4444"/>
        <SolidColorBrush x:Key="TextMain" Color="#0F172A"/>
        <SolidColorBrush x:Key="TextMuted" Color="#64748B"/>
        <SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#E2E8F0"/>

        <!-- Card Style -->
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="2" Opacity="0.04" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Button -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E2E8F0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Modern TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT SIDEBAR -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBg}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- App Header -->
                <StackPanel Grid.Row="0" Margin="20,24,20,20">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="36" Height="36" Background="#0284C7" CornerRadius="8" Margin="0,0,10,0">
                            <TextBlock Text="FN" Foreground="White" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="飞牛同步增强版" Foreground="#FFFFFF" FontWeight="Bold" FontSize="15"/>
                            <TextBlock Text="FN Sync Plus" Foreground="#94A3B8" FontSize="11"/>
                        </StackPanel>
                    </StackPanel>
                    <Border Background="#1E293B" CornerRadius="4" Padding="6,3" Margin="0,14,0,0" HorizontalAlignment="Left">
                        <TextBlock Text="长文件名无损映射 v1.0" Foreground="#38BDF8" FontSize="11" FontWeight="Medium"/>
                    </Border>
                </StackPanel>

                <!-- Navigation Menu -->
                <StackPanel Grid.Row="1" Margin="10,10,10,0">
                    <RadioButton x:Name="NavDevice" Content="🖥️  设备连接" Style="{x:Null}" Height="46" IsChecked="True" Checked="Nav_Checked"
                                 Foreground="#F8FAFC" FontSize="14" FontWeight="Medium" VerticalContentAlignment="Center" Padding="14,0" Cursor="Hand"/>
                    <RadioButton x:Name="NavTask" Content="📁  同步任务" Style="{x:Null}" Height="46" Checked="Nav_Checked"
                                 Foreground="#F8FAFC" FontSize="14" FontWeight="Medium" VerticalContentAlignment="Center" Padding="14,0" Cursor="Hand"/>
                    <RadioButton x:Name="NavMonitor" Content="📊  同步监控" Style="{x:Null}" Height="46" Checked="Nav_Checked"
                                 Foreground="#F8FAFC" FontSize="14" FontWeight="Medium" VerticalContentAlignment="Center" Padding="14,0" Cursor="Hand"/>
                    <RadioButton x:Name="NavRestore" Content="🔄  恢复中心" Style="{x:Null}" Height="46" Checked="Nav_Checked"
                                 Foreground="#F8FAFC" FontSize="14" FontWeight="Medium" VerticalContentAlignment="Center" Padding="14,0" Cursor="Hand"/>
                    <RadioButton x:Name="NavSettings" Content="⚙️  日志与设置" Style="{x:Null}" Height="46" Checked="Nav_Checked"
                                 Foreground="#F8FAFC" FontSize="14" FontWeight="Medium" VerticalContentAlignment="Center" Padding="14,0" Cursor="Hand"/>
                </StackPanel>

                <!-- Bottom Status -->
                <Border Grid.Row="2" Background="#1E293B" Padding="14,12" Margin="12,0,12,16" CornerRadius="8">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="{StaticResource WarningColor}" Margin="0,0,8,0"/>
                            <TextBlock x:Name="StatusText" Text="NAS 未连接" Foreground="#E2E8F0" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock x:Name="StatusSubText" Text="请在【设备连接】中登录" Foreground="#94A3B8" FontSize="11" Margin="17,3,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- RIGHT MAIN CONTENT -->
        <Grid Grid.Column="1" Margin="24">

            <!-- TAB 0: 设备连接 -->
            <Grid x:Name="TabDeviceView" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,16">
                    <TextBlock Text="NAS 设备连接与登录" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextMain}"/>
                    <TextBlock Text="自动发现局域网 NAS 或手动指定 IP，建立经过 Windows SMB 认证的安全会话" FontSize="13" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0"/>
                </StackPanel>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: LAN Discovery -->
                    <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,14,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Stretch" Margin="0,0,0,12">
                                <TextBlock Text="局域网 NAS 发现" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                                <Button Content="🔍 重新搜索" Click="BtnRefreshDiscovery_Click" Style="{StaticResource SecondaryBtn}" Padding="8,4" FontSize="12" HorizontalAlignment="Right" Margin="110,0,0,0"/>
                            </StackPanel>

                            <ListBox x:Name="ListDiscoveredDevices" Grid.Row="1" BorderBrush="#E2E8F0" SelectionChanged="ListDiscoveredDevices_SelectionChanged" Background="#F8FAFC">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="10,8" Margin="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13"/>
                                                    <TextBlock Text="{Binding IpAddress}" Foreground="#64748B" FontSize="12" Margin="0,2,0,0"/>
                                                    <TextBlock Text="{Binding DiscoveryMethod}" Foreground="#0284C7" FontSize="11"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="在线" Foreground="#10B981" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock x:Name="TxtDiscoveryHint" Grid.Row="2" Text="提示: 点击设备自动填入右侧登录表单" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,8,0,0"/>
                        </Grid>
                    </Border>

                    <!-- Right: Authentication Form -->
                    <Border Grid.Column="1" Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="NAS 身份凭据登录" FontSize="16" FontWeight="Bold" Margin="0,0,0,16"/>

                            <TextBlock Text="NAS 地址 (IP 或主机名):" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                            <TextBox x:Name="TxtNasAddress" Text="192.168.8.120" Margin="0,0,0,14"/>

                            <TextBlock Text="NAS 账号 (用户名):" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                            <TextBox x:Name="TxtNasUsername" Text="wangxiaoliang" Margin="0,0,0,14"/>

                            <TextBlock Text="NAS 密码:" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                            <PasswordBox x:Name="TxtNasPassword" Margin="0,0,0,14"/>

                            <CheckBox x:Name="ChkRememberPassword" Content="记住账号与密码 (使用 Windows DPAPI 加密安全保护)" IsChecked="True" FontSize="12" Margin="0,0,0,20"/>

                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BtnConnectNas" Content="🔐  登录并连接 NAS" Click="BtnConnectNas_Click" Style="{StaticResource PrimaryBtn}" Width="180" Height="40"/>
                                <Button x:Name="BtnDisconnectNas" Content="断开会话" Click="BtnDisconnectNas_Click" Style="{StaticResource SecondaryBtn}" Margin="12,0,0,0" Height="40"/>
                            </StackPanel>

                            <!-- Alert Banner -->
                            <Border x:Name="BorderLoginResult" Margin="0,20,0,0" Padding="12" CornerRadius="6" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" Visibility="Collapsed">
                                <TextBlock x:Name="TxtLoginResult" Text="提示信息" FontSize="13" TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- TAB 1: 同步任务与 NAS 文件夹浏览 -->
            <Grid x:Name="TabTaskView" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,16">
                    <TextBlock Text="同步任务配置" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextMain}"/>
                    <TextBlock Text="选择电脑本地需要备份的目录，以及 NAS 上的存储目标文件夹" FontSize="13" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0"/>
                </StackPanel>

                <Border Grid.Row="1" Style="{StaticResource CardBorder}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Local Source Path -->
                            <TextBlock Text="本地源文件夹 (Windows):" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtSourceFolder" Text="D:\FN_AutoSync_Package\FN_Sync_Test" Grid.Column="0"/>
                                <Button Content="📂 浏览本地..." Click="BtnBrowseLocal_Click" Style="{StaticResource SecondaryBtn}" Grid.Column="1" Margin="10,0,0,0"/>
                            </Grid>

                            <!-- NAS Destination Path -->
                            <TextBlock Text="NAS 目标备份目录 (SMB 共享/子文件夹):" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtNasTargetUnc" Text="\\192.168.8.120\FN_Sync_Test" Grid.Column="0" IsReadOnly="True" Background="#F8FAFC"/>
                                <Button Content="🌐 浏览 NAS 文件夹..." Click="BtnOpenNasBrowser_Click" Style="{StaticResource PrimaryBtn}" Grid.Column="1" Margin="10,0,0,0"/>
                            </Grid>

                            <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,18">
                                <StackPanel>
                                    <TextBlock Text="✨ 长文件名无损兼容已开启" FontWeight="Bold" Foreground="#15803D" FontSize="13"/>
                                    <TextBlock Text="• 普通文件（UTF-8 &lt;= 255 字节）100% 保持原始名称与目录结构不变。" Foreground="#166534" FontSize="12" Margin="0,3,0,0"/>
                                    <TextBlock Text="• 仅当文件名或文件夹名超过 NAS 255 字节限制时，自动映射为稳定短名称，并将原名持久化记录在 NAS 清单中。" Foreground="#166534" FontSize="12" Margin="0,2,0,0"/>
                                    <TextBlock Text="• 任何时候更换电脑，均可使用【恢复中心】一键 100% 还原原始完整长名称。" Foreground="#166534" FontSize="12" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="同步模式与策略:" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
                            <RadioButton Content="单向备份模式 (Windows → NAS) —— 推荐。本地删除文件时不自动删除 NAS 备份，保障数据安全。" IsChecked="True" Margin="0,0,0,14" FontSize="13"/>

                            <TextBlock Text="自动执行设置:" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
                            <CheckBox x:Name="ChkRealtimeWatch" Content="启用本地文件变动实时自动监测 (保存/修改即刻准备同步)" IsChecked="True" Margin="0,0,0,8" FontSize="13"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                                <CheckBox x:Name="ChkAutoInterval" Content="启用后台定期增量同步，轮询周期:" IsChecked="True" VerticalAlignment="Center" FontSize="13"/>
                                <ComboBox x:Name="CmbIntervalMinutes" Width="100" Margin="10,0,0,0" SelectedIndex="1">
                                    <ComboBoxItem Content="1 分钟"/>
                                    <ComboBoxItem Content="5 分钟"/>
                                    <ComboBoxItem Content="15 分钟"/>
                                    <ComboBoxItem Content="30 分钟"/>
                                    <ComboBoxItem Content="1 小时"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal">
                                <Button Content="💾 保存配置" Click="BtnSaveSettings_Click" Style="{StaticResource SecondaryBtn}" Width="120" Height="40"/>
                                <Button Content="🚀 立即运行增量同步" Click="BtnRunSyncNow_Click" Style="{StaticResource PrimaryBtn}" Margin="14,0,0,0" Width="180" Height="40"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- TAB 2: 同步监控 -->
            <Grid x:Name="TabMonitorView" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Top 5 Metric Cards -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="扫描总数" Foreground="{StaticResource TextMuted}" FontSize="12"/>
                            <TextBlock x:Name="TxtMetricTotal" Text="0" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextMain}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="4,0,4,0">
                        <StackPanel>
                            <TextBlock Text="已上传/更新" Foreground="{StaticResource TextMuted}" FontSize="12"/>
                            <TextBlock x:Name="TxtMetricUploaded" Text="0" FontSize="24" FontWeight="Bold" Foreground="{StaticResource SuccessColor}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource CardBorder}" Margin="4,0,4,0">
                        <StackPanel>
                            <TextBlock Text="跳过未修改" Foreground="{StaticResource TextMuted}" FontSize="12"/>
                            <TextBlock x:Name="TxtMetricUnchanged" Text="0" FontSize="24" FontWeight="Bold" Foreground="{StaticResource PrimaryColor}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="3" Style="{StaticResource CardBorder}" Margin="4,0,4,0">
                        <StackPanel>
                            <TextBlock Text="超长名映射数" Foreground="{StaticResource TextMuted}" FontSize="12"/>
                            <TextBlock x:Name="TxtMetricLongNames" Text="0" FontSize="24" FontWeight="Bold" Foreground="#8B5CF6" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Style="{StaticResource CardBorder}" Margin="8,0,0,0">
                        <StackPanel>
                            <TextBlock Text="失败文件数" Foreground="{StaticResource TextMuted}" FontSize="12"/>
                            <TextBlock x:Name="TxtMetricFailed" Text="0" FontSize="24" FontWeight="Bold" Foreground="{StaticResource DangerColor}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Progress & Current File -->
                <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock x:Name="TxtCurrentSyncStatus" Text="状态: 空闲中" FontWeight="Bold" FontSize="14"/>
                            <TextBlock x:Name="TxtTransferSpeed" Text="0 KB/s" HorizontalAlignment="Right" Foreground="{StaticResource TextMuted}" FontSize="13"/>
                        </Grid>
                        <ProgressBar x:Name="ProgressSync" Height="10" Value="0" Maximum="100" Margin="0,0,0,8"/>
                        <TextBlock x:Name="TxtCurrentSyncFile" Text="待命..." Foreground="{StaticResource TextMuted}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <!-- Live Log Box -->
                <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="实时同步日志" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
                        <TextBox x:Name="TxtRealtimeLog" Grid.Row="1" IsReadOnly="True" VerticalScrollBarVisibility="Auto" Background="#0F172A" Foreground="#38BDF8" FontFamily="Consolas, Microsoft YaHei UI" FontSize="12"/>
                    </Grid>
                </Border>

                <!-- Control Buttons -->
                <StackPanel Grid.Row="3" Orientation="Horizontal">
                    <Button Content="▶ 立即增量同步" Click="BtnRunSyncNow_Click" Style="{StaticResource PrimaryBtn}" Width="150" Height="38"/>
                    <Button x:Name="BtnPauseSync" Content="⏸ 暂停/取消" Click="BtnPauseSync_Click" Style="{StaticResource SecondaryBtn}" Margin="12,0,0,0" Width="120" Height="38"/>
                    <Button Content="清空日志输出" Click="BtnClearLog_Click" Style="{StaticResource SecondaryBtn}" Margin="12,0,0,0" Height="38"/>
                </StackPanel>
            </Grid>

            <!-- TAB 3: 恢复中心 -->
            <Grid x:Name="TabRestoreView" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,14">
                    <TextBlock Text="原始文件名与目录异机恢复中心" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextMain}"/>
                    <TextBlock Text="从 NAS 备份中自动读取清单，无损还原所有超长文件名与多层嵌套目录结构，并逐一校验 SHA-256 完整性" FontSize="13" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0"/>
                </StackPanel>

                <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- NAS Source Picker -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="NAS 备份位置:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>
                            <TextBox x:Name="TxtRestoreNasPath" Text="\\192.168.8.120\FN_Sync_Test" Grid.Column="1"/>
                            <Button Content="🔍 检查并预览清单" Click="BtnPreviewRestore_Click" Style="{StaticResource SecondaryBtn}" Grid.Column="2" Margin="10,0,0,0"/>
                        </Grid>

                        <!-- Local Destination Picker -->
                        <Grid Grid.Row="1" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="本地恢复位置:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>
                            <TextBox x:Name="TxtRestoreLocalDest" Text="D:\Restored_Files" Grid.Column="1"/>
                            <Button Content="📂 浏览本地..." Click="BtnBrowseRestoreLocal_Click" Style="{StaticResource SecondaryBtn}" Grid.Column="2" Margin="10,0,0,0"/>
                        </Grid>

                        <!-- Preview DataGrid -->
                        <DataGrid x:Name="GridRestorePreview" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" BorderBrush="#E2E8F0" Background="#FFFFFF">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="原始完整文件名 (恢复后)" Binding="{Binding OriginalRelPath}" Width="3*"/>
                                <DataGridTextColumn Header="NAS 存储别名" Binding="{Binding StoredRelPath}" Width="2*"/>
                                <DataGridTextColumn Header="大小 (字节)" Binding="{Binding Size}" Width="90"/>
                                <DataGridCheckBoxColumn Header="超长转换" Binding="{Binding IsLongName}" Width="80"/>
                                <DataGridTextColumn Header="SHA-256 完整性哈希" Binding="{Binding Sha256}" Width="160"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Options & Actions -->
                        <StackPanel Grid.Row="3" Margin="0,12,0,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="重名冲突策略:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>
                                <ComboBox x:Name="CmbConflictPolicy" Width="180" SelectedIndex="0">
                                    <ComboBoxItem Content="跳过已存在且相同的文件"/>
                                    <ComboBoxItem Content="强制覆盖已存在文件"/>
                                    <ComboBoxItem Content="自动重命名 (加时间戳)"/>
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Bottom Run Restore Section -->
                <Border Grid.Row="2" Style="{StaticResource CardBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="TxtRestoreStatus" Text="就绪，点击开始恢复" FontWeight="SemiBold" FontSize="13"/>
                            <ProgressBar x:Name="ProgressRestore" Height="8" Margin="0,6,0,0" Value="0" Maximum="100"/>
                        </StackPanel>
                        <Button x:Name="BtnStartRestore" Content="🚀 开始一键完整恢复" Click="BtnStartRestore_Click" Style="{StaticResource PrimaryBtn}" Grid.Column="1" Margin="20,0,0,0" Height="40" Width="180"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- TAB 4: 日志与系统设置 -->
            <Grid x:Name="TabSettingsView" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,16">
                    <TextBlock Text="系统设置与失败项重试" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextMain}"/>
                    <TextBlock Text="开机自启、托盘运行、失败项目重试入口及系统运行日志" FontSize="13" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0"/>
                </StackPanel>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Failed Items -->
                    <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,10,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="同步失败文件列表 (支持重试)" FontWeight="Bold" FontSize="15" Margin="0,0,0,10"/>
                            <ListBox x:Name="ListFailedItems" Grid.Row="1" BorderBrush="#E2E8F0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="6" Margin="2" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="4">
                                            <StackPanel>
                                                <TextBlock Text="{Binding RelativePath}" FontWeight="Bold" Foreground="#991B1B" FontSize="12"/>
                                                <TextBlock Text="{Binding ErrorMessage}" Foreground="#B91C1C" FontSize="11" Margin="0,2,0,0"/>
                                                <TextBlock Text="{Binding FailedTime, StringFormat='{}失败时间: {0:HH:mm:ss}'}" Foreground="#6B7280" FontSize="10"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Button Content="🔄 立即重试所有失败文件" Click="BtnRetryFailed_Click" Style="{StaticResource SecondaryBtn}" Grid.Row="2" Margin="0,10,0,0" Height="36"/>
                        </Grid>
                    </Border>

                    <!-- Right: System Options -->
                    <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="10,0,0,0">
                        <StackPanel>
                            <TextBlock Text="常规运行选项" FontWeight="Bold" FontSize="15" Margin="0,0,0,14"/>

                            <CheckBox x:Name="ChkStartWithWindows" Content="随 Windows 启动开机自启 (静默托盘运行)" FontSize="13" Margin="0,0,0,12"/>
                            <CheckBox x:Name="ChkMinimizeToTray" Content="关闭主窗口时最小化到系统托盘 (保持后台自动同步)" IsChecked="True" FontSize="13" Margin="0,0,0,18"/>

                            <Separator Margin="0,0,0,16"/>

                            <TextBlock Text="连接安全性管理" FontWeight="Bold" FontSize="15" Margin="0,0,0,12"/>
                            <Button Content="🗑️ 清除本机保存的 NAS 密码凭据" Click="BtnClearCredentials_Click" Style="{StaticResource SecondaryBtn}" Height="36" HorizontalAlignment="Left"/>
                            <TextBlock Text="密码使用 Windows DPAPI 本机加密存储，不会以明文暴露" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,6,0,16"/>

                            <Separator Margin="0,0,0,16"/>

                            <TextBlock Text="日志导出" FontWeight="Bold" FontSize="15" Margin="0,0,0,12"/>
                            <Button Content="📄 导出完整日志文件..." Click="BtnExportLog_Click" Style="{StaticResource SecondaryBtn}" Height="36" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

        </Grid>

        <!-- MODAL OVERLAY: NAS 文件夹浏览器 (重点功能) -->
        <Grid x:Name="ModalNasBrowser" Grid.Column="0" Grid.ColumnSpan="2" Background="#90000000" Visibility="Collapsed">
            <Border Style="{StaticResource CardBorder}" Width="720" Height="540" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="浏览与选择 NAS 文件夹" FontSize="17" FontWeight="Bold"/>
                        <Button Content="✕" Click="BtnCloseNasBrowser_Click" Style="{StaticResource SecondaryBtn}" HorizontalAlignment="Right" Width="32" Height="32" Padding="0"/>
                    </Grid>

                    <!-- Breadcrumbs & Up Button -->
                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="⬆ 返回上一级" Click="BtnNasBrowserUp_Click" Style="{StaticResource SecondaryBtn}" Grid.Column="0" Margin="0,0,8,0" Height="32"/>
                        <TextBox x:Name="TxtNasBrowserCurrentPath" Text="\\" Grid.Column="1" IsReadOnly="True" Background="#F8FAFC" Height="32"/>
                        <Button Content="➕ 新建文件夹" Click="BtnNasBrowserNewFolder_Click" Style="{StaticResource SecondaryBtn}" Grid.Column="2" Margin="8,0,0,0" Height="32"/>
                    </Grid>

                    <!-- Folder List -->
                    <ListBox x:Name="ListNasBrowserItems" Grid.Row="2" BorderBrush="#E2E8F0" MouseDoubleClick="ListNasBrowserItems_MouseDoubleClick" Background="#FFFFFF">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8,6" Margin="1" Background="Transparent">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="📁" FontSize="16" Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="Medium" FontSize="13"/>
                                            <TextBlock Text="{Binding FullUncPath}" Foreground="#94A3B8" FontSize="11"/>
                                        </StackPanel>
                                        <TextBlock Text="双击进入" Foreground="#94A3B8" FontSize="11" Grid.Column="2" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Bottom Select Action -->
                    <Grid Grid.Row="3" Margin="0,14,0,0">
                        <TextBlock x:Name="TxtNasBrowserSelectionHint" Text="提示: 双击进入子文件夹，或点击【选择当前文件夹】作为备份目标" FontSize="12" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="取消" Click="BtnCloseNasBrowser_Click" Style="{StaticResource SecondaryBtn}" Width="90" Height="36"/>
                            <Button Content="✔ 选择当前文件夹" Click="BtnSelectNasBrowserFolder_Click" Style="{StaticResource PrimaryBtn}" Margin="10,0,0,0" Width="150" Height="36"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</Window>
