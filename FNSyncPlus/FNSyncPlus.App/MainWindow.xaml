<Window x:Class="FNSyncPlus.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="飞牛同步增强版 (FN Sync Plus) v2.2"
        Height="780" Width="1180"
        MinHeight="660" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBgBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI Variable, sans-serif">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOP GLOBAL HEADER BAR -->
        <Border Grid.Row="0" Background="{StaticResource HeaderBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- App Brand -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" Background="{StaticResource PrimaryAccentBrush}" CornerRadius="8" Margin="0,0,12,0">
                        <Path Data="{StaticResource GeoSync}" Fill="#FFFFFF" Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="飞牛同步增强版" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextMainBrush}"/>
                            <Border Background="{StaticResource PrimaryLightBrush}" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="v2.2 专业版" FontSize="10" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="私人空间优先 · 自动规划同名子目录 · 长文件名无损映射" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Middle NAS Connection Pill -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border x:Name="BorderNasPill" Background="#F1F5F9" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="12,6" Cursor="Hand" MouseLeftButtonUp="BorderNasPill_Click">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="DotNasStatus" Width="8" Height="8" Fill="{StaticResource WarningBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtNasPillText" Text="NAS 未连接 (点击登录)" FontSize="12" FontWeight="Medium" Foreground="{StaticResource TextMainBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Top Right Primary Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Click="BtnAddFolderWizard_Click" Style="{StaticResource FluentPrimaryBtn}" Height="36" Padding="16,6" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource GeoAdd}" Fill="#FFFFFF" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="添加文件夹备份" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnThemeToggle" Click="BtnThemeToggle_Click" Style="{StaticResource FluentSecondaryBtn}" Width="36" Height="36" Padding="0" ToolTip="切换浅色/深色主题">
                        <Path x:Name="IconThemeToggle" Data="{StaticResource GeoSun}" Fill="{StaticResource TextMainBrush}" Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- TOP NAVIGATION SEGMENTED TABS -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="20,0">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="TabNavTasks" Style="{StaticResource FluentNavTab}" IsChecked="True" Checked="TabNav_Checked">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource GeoFolder}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="同步任务" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="TabNavRestore" Style="{StaticResource FluentNavTab}" Checked="TabNav_Checked">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource GeoRefresh}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="异机恢复中心" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="TabNavDevice" Style="{StaticResource FluentNavTab}" Checked="TabNav_Checked">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource GeoDevice}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="NAS 设备与网络" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="TabNavSettings" Style="{StaticResource FluentNavTab}" Checked="TabNav_Checked">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource GeoSettings}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="全局设置" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
            </StackPanel>
        </Border>

        <!-- MAIN CONTENT AREA -->
        <Grid Grid.Row="2" Margin="20,16">

            <!-- TAB 1: SYNC TASKS DASHBOARD -->
            <Grid x:Name="ViewTasks" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Overview Metric Strip -->
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource FluentCard}" Margin="0,0,6,0" Padding="12,10">
                        <StackPanel>
                            <TextBlock Text="任务总数" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock x:Name="TxtStatTotalTasks" Text="0" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextMainBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource FluentCard}" Margin="3,0,3,0" Padding="12,10">
                        <StackPanel>
                            <TextBlock Text="正在同步" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock x:Name="TxtStatSyncingTasks" Text="0" FontSize="20" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource FluentCard}" Margin="3,0,3,0" Padding="12,10">
                        <StackPanel>
                            <TextBlock Text="空闲就绪" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock x:Name="TxtStatIdleTasks" Text="0" FontSize="20" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="3" Style="{StaticResource FluentCard}" Margin="3,0,3,0" Padding="12,10">
                        <StackPanel>
                            <TextBlock Text="最近同步时间" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock x:Name="TxtStatLastSyncTime" Text="--" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextMainBrush}" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Style="{StaticResource FluentCard}" Margin="6,0,0,0" Padding="12,10">
                        <StackPanel>
                            <TextBlock Text="最近异常数" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock x:Name="TxtStatFailedTasks" Text="0" FontSize="20" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Filter & Global Actions Strip -->
                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="同步任务列表" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextMainBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="(每个文件夹独立运行，沙箱隔离)" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Click="BtnSyncAllTasks_Click" Style="{StaticResource FluentSecondaryBtn}" Height="30" Padding="12,4" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeoPlay}" Fill="{StaticResource TextMainBrush}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="全部立即同步" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Click="BtnPreAnalyzeAll_Click" Style="{StaticResource FluentSecondaryBtn}" Height="30" Padding="12,4">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeoSearch}" Fill="{StaticResource TextMainBrush}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="预分析变动" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Empty State View (Shown when 0 tasks) -->
                <Border x:Name="BorderEmptyTasks" Grid.Row="2" Style="{StaticResource FluentCard}" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Width="440" Padding="32,28">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="64" Height="64" Background="{StaticResource PrimaryLightBrush}" CornerRadius="32" HorizontalAlignment="Center" Margin="0,0,0,16">
                            <Path Data="{StaticResource GeoFolder}" Fill="{StaticResource PrimaryAccentBrush}" Width="32" Height="32" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="暂无同步任务" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{StaticResource TextMainBrush}"/>
                        <TextBlock Text="点击下方按钮添加本地文件夹，系统将自动在飞牛 NAS 私人空间规划同名备份目录，并提供长文件名无损兼容。" FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,20"/>
                        <Button Click="BtnAddFolderWizard_Click" Style="{StaticResource FluentPrimaryBtn}" Width="200" Height="38">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeoAdd}" Fill="#FFFFFF" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="添加文件夹备份向导" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Task Cards List -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ItemsControlTasks">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource FluentCard}" Margin="0,0,0,12" Padding="16">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Card Header: Title + Status + Actions -->
                                        <Grid Grid.Row="0" Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Data="{StaticResource GeoFolder}" Fill="{StaticResource PrimaryAccentBrush}" Width="18" Height="18" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding TaskName}" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextMainBrush}" VerticalAlignment="Center"/>
                                                <Border Background="{Binding StateBadgeBgHex}" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayStatus}" FontSize="11" Foreground="{Binding StateBadgeColorHex}" FontWeight="SemiBold"/>
                                                </Border>
                                            </StackPanel>

                                            <!-- Task Action Buttons -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Click="BtnTaskRunSync_Click" Tag="{Binding TaskId}" Style="{StaticResource FluentSecondaryBtn}" Height="28" Padding="10,2" Margin="0,0,6,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource GeoPlay}" Fill="{StaticResource PrimaryAccentBrush}" Width="10" Height="10" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="同步" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Click="BtnTaskPause_Click" Tag="{Binding TaskId}" Style="{StaticResource FluentSecondaryBtn}" Height="28" Padding="10,2" Margin="0,0,6,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource GeoPause}" Fill="{StaticResource WarningBrush}" Width="10" Height="10" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="暂停" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Click="BtnTaskViewLog_Click" Tag="{Binding TaskId}" Style="{StaticResource FluentSecondaryBtn}" Height="28" Padding="10,2" Margin="0,0,6,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource GeoLog}" Fill="{StaticResource TextMutedBrush}" Width="10" Height="10" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="日志" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Click="BtnTaskDelete_Click" Tag="{Binding TaskId}" Style="{StaticResource FluentDangerBtn}" Height="28" Width="30" Padding="0" ToolTip="删除任务配置 (不删除文件)">
                                                    <Path Data="{StaticResource GeoTrash}" Fill="#DC2626" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Paths Row -->
                                        <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                        <Path Data="{StaticResource GeoPC}" Fill="{StaticResource TextSubtleBrush}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="本地源文件夹:" FontSize="10" Foreground="{StaticResource TextSubtleBrush}"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding SourceFolder}" FontSize="12" Foreground="{StaticResource TextMainBrush}" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <Path Grid.Column="1" Data="{StaticResource GeoArrowRight}" Fill="#94A3B8" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="14,0"/>
                                                <StackPanel Grid.Column="2">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                        <Path Data="{StaticResource GeoCloud}" Fill="{StaticResource PrimaryAccentBrush}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="NAS 目标备份子目录:" FontSize="10" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding DestinationFolder}" FontSize="12" Foreground="{StaticResource PrimaryAccentBrush}" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- Live Progress (Visible when active) -->
                                        <Grid Grid.Row="2" Margin="0,0,0,8">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0" Margin="0,0,0,4">
                                                <TextBlock Text="{Binding CurrentFile, StringFormat='{}传输: {0}'}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding CurrentProgress, StringFormat='{}{0:F0}%'}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <ProgressBar Grid.Row="1" Value="{Binding CurrentProgress}" Maximum="100" Height="5"/>
                                        </Grid>

                                        <!-- Metrics Strip -->
                                        <StackPanel Grid.Row="3" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding LastUploadedFiles, StringFormat='{}已上传: {0}'}" FontSize="11" Foreground="{StaticResource SuccessBrush}" Margin="0,0,16,0"/>
                                            <TextBlock Text="{Binding LastUnchangedFiles, StringFormat='{}跳过未变动: {0}'}" FontSize="11" Foreground="{StaticResource PrimaryAccentBrush}" Margin="0,0,16,0"/>
                                            <TextBlock Text="{Binding LastLongNameFiles, StringFormat='{}长文件名映射: {0}'}" FontSize="11" Foreground="{StaticResource PurpleAccentBrush}" Margin="0,0,16,0"/>
                                            <TextBlock Text="{Binding LastSyncTime, StringFormat='{}上次备份: {0:yyyy-MM-dd HH:mm}'}" FontSize="11" Foreground="{StaticResource TextSubtleBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- TAB 2: MULTI-TASK RESTORE CENTER -->
            <Grid x:Name="ViewRestore" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,14">
                    <TextBlock Text="多任务异机无损还原中心" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextMainBrush}"/>
                    <TextBlock Text="自动从 NAS 备份根目录检索所有备份包，无需原电脑配置库，一键无损还原原始长文件名与目录结构，逐一进行 SHA-256 完整性强校验" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0"/>
                </StackPanel>

                <Border Grid.Row="1" Style="{StaticResource FluentCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Scan NAS Root Bar -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="NAS 备份根目录:" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13" Margin="0,0,10,0"/>
                            <TextBox x:Name="TxtRestoreScanRoot" Grid.Column="1" Height="34" FontSize="13"/>
                            <Button Click="BtnScanRestorePackages_Click" Style="{StaticResource FluentPrimaryBtn}" Grid.Column="2" Margin="10,0,0,0" Height="34">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource GeoSearch}" Fill="#FFFFFF" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="自动检索 NAS 备份包" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Discovered Packages Selector -->
                        <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="选择要还原的备份任务:" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12" Margin="0,0,10,0"/>
                                <ComboBox x:Name="CmbDiscoveredPackages" Grid.Column="1" Height="32" SelectionChanged="CmbDiscoveredPackages_SelectionChanged"/>
                                <TextBlock x:Name="TxtDiscoveredPackageDetail" Grid.Column="2" Text="" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </Grid>
                        </Border>

                        <!-- Preview Files Grid -->
                        <DataGrid x:Name="GridRestoreFiles" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                                  BorderBrush="{StaticResource CardBorderBrush}" Background="#FFFFFF" RowHeight="32">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="原始完整文件名 (恢复后)" Binding="{Binding OriginalRelPath}" Width="3*"/>
                                <DataGridTextColumn Header="NAS 存储别名" Binding="{Binding StoredRelPath}" Width="2*"/>
                                <DataGridTextColumn Header="文件大小 (字节)" Binding="{Binding Size}" Width="100"/>
                                <DataGridCheckBoxColumn Header="超长名转换" Binding="{Binding IsLongName}" Width="85"/>
                                <DataGridTextColumn Header="SHA-256 完整性哈希" Binding="{Binding Sha256}" Width="160"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Local Destination & Options -->
                        <Grid Grid.Row="3" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="还原到本地路径:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>
                            <TextBox x:Name="TxtRestoreLocalTarget" Grid.Column="1" Height="34" Text="D:\Restored_Files"/>
                            <Button Click="BtnBrowseRestoreLocal_Click" Style="{StaticResource FluentSecondaryBtn}" Grid.Column="2" Margin="8,0,16,0" Height="34">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource GeoFolder}" Fill="{StaticResource TextMainBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="浏览..." VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <ComboBox x:Name="CmbRestoreConflictPolicy" Grid.Column="3" Width="170" Height="34" SelectedIndex="0">
                                <ComboBoxItem Content="跳过已存在文件"/>
                                <ComboBoxItem Content="覆盖已存在文件"/>
                                <ComboBoxItem Content="自动加时间戳重命名"/>
                            </ComboBox>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Bottom Run Restore Strip -->
                <Border Grid.Row="2" Style="{StaticResource FluentCard}" Margin="0,12,0,0" Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtRestoreGlobalStatus" Text="请选择上方备份包并点击开始恢复" FontWeight="SemiBold" FontSize="13"/>
                            <ProgressBar x:Name="ProgressRestoreGlobal" Height="6" Margin="0,6,0,0" Value="0" Maximum="100"/>
                        </StackPanel>
                        <Button x:Name="BtnExecuteRestore" Click="BtnExecuteRestore_Click" Style="{StaticResource FluentPrimaryBtn}" Grid.Column="1" Height="38" Width="260" Margin="20,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeoCheck}" Fill="#FFFFFF" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="开始完整还原 (SHA-256 强校验)" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </Grid>

            <!-- TAB 3: NAS DEVICE & SMB NETWORK -->
            <Grid x:Name="ViewDevice" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,14">
                    <TextBlock Text="飞牛 NAS 设备连接与 SMB 身份凭据" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextMainBrush}"/>
                    <TextBlock Text="管理与 NAS 的经过 Windows Networking 认证的安全会话，所有同步任务共享此连接" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0"/>
                </StackPanel>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: LAN NAS Discovery -->
                    <Border Grid.Column="0" Style="{StaticResource FluentCard}" Margin="0,0,12,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <TextBlock Text="局域网 NAS 发现" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                                <Button Click="BtnRefreshLanDevices_Click" Style="{StaticResource FluentSecondaryBtn}" HorizontalAlignment="Right" Padding="8,4" FontSize="12">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource GeoRefresh}" Fill="{StaticResource TextMainBrush}" Width="10" Height="10" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="重新搜索" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <ListBox x:Name="ListDiscoveredNas" Grid.Row="1" BorderBrush="{StaticResource CardBorderBrush}" Background="#F8FAFC" SelectionChanged="ListDiscoveredNas_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="10,8" Margin="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13"/>
                                                <TextBlock Text="{Binding IpAddress}" Foreground="#64748B" FontSize="12" Margin="0,2,0,0"/>
                                                <TextBlock Text="{Binding DiscoveryMethod}" Foreground="{StaticResource PrimaryAccentBrush}" FontSize="11"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock x:Name="TxtDiscoveryStatus" Grid.Row="2" Text="提示: 单击发现的设备自动填入右侧登录表单" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,8,0,0"/>
                        </Grid>
                    </Border>

                    <!-- Right: Login Form -->
                    <Border Grid.Column="1" Style="{StaticResource FluentCard}">
                        <StackPanel>
                            <TextBlock Text="NAS 身份凭据登录" FontSize="15" FontWeight="Bold" Margin="0,0,0,16"/>

                            <TextBlock Text="NAS 地址 (IP 或主机名):" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                            <TextBox x:Name="TxtDeviceAddress" Height="36" Margin="0,0,0,14"/>

                            <TextBlock Text="NAS 用户名 (账号):" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                            <TextBox x:Name="TxtDeviceUsername" Height="36" Margin="0,0,0,14"/>

                            <TextBlock Text="NAS 登录密码:" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                            <PasswordBox x:Name="TxtDevicePassword" Height="36" Margin="0,0,0,14"/>

                            <CheckBox x:Name="ChkDeviceRemember" Content="记住账号与密码 (使用 Windows DPAPI 本机加密存储，绝无明文泄露)" IsChecked="True" FontSize="12" Margin="0,0,0,20"/>

                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BtnDeviceLogin" Click="BtnDeviceLogin_Click" Style="{StaticResource FluentPrimaryBtn}" Height="38" Width="190">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource GeoShield}" Fill="#FFFFFF" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="登录并建立 SMB 认证" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Content="断开会话" Click="BtnDeviceDisconnect_Click" Style="{StaticResource FluentSecondaryBtn}" Height="38" Margin="10,0,0,0" Padding="14,0"/>
                            </StackPanel>

                            <Border x:Name="BorderDeviceLoginResult" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,16,0,0" Visibility="Collapsed">
                                <TextBlock x:Name="TxtDeviceLoginResult" Text="" FontSize="12" TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- TAB 4: GLOBAL SETTINGS -->
            <Grid x:Name="ViewSettings" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,14">
                    <TextBlock Text="系统全局选项与安全性" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextMainBrush}"/>
                    <TextBlock Text="开机启动、系统托盘、并发线程管理与本机加密凭据维护" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0"/>
                </StackPanel>

                <Border Grid.Row="1" Style="{StaticResource FluentCard}">
                    <StackPanel MaxWidth="680" HorizontalAlignment="Left">
                        <TextBlock Text="常规运行策略" FontWeight="Bold" FontSize="14" Margin="0,0,0,12"/>
                        <CheckBox x:Name="ChkGlobalAutoStart" Content="随 Windows 开机静默启动 (后台托盘守护)" FontSize="13" Margin="0,0,0,10"/>
                        <CheckBox x:Name="ChkGlobalMinimizeToTray" Content="关闭主窗口时最小化到系统托盘 (保持自动同步)" IsChecked="True" FontSize="13" Margin="0,0,0,18"/>

                        <Separator Margin="0,0,0,16"/>

                        <TextBlock Text="并发调度控制" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                            <TextBlock Text="全局最大并发执行任务数:" VerticalAlignment="Center" FontSize="13" Margin="0,0,12,0"/>
                            <ComboBox x:Name="CmbMaxConcurrent" Width="100" Height="32" SelectedIndex="1">
                                <ComboBoxItem Content="1 (排队)"/>
                                <ComboBoxItem Content="2 (推荐)"/>
                                <ComboBoxItem Content="3"/>
                                <ComboBoxItem Content="4"/>
                            </ComboBox>
                        </StackPanel>

                        <Separator Margin="0,0,0,16"/>

                        <TextBlock Text="本机凭据管理" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
                        <Button Click="BtnClearSavedCredentials_Click" Style="{StaticResource FluentDangerBtn}" Height="34" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeoTrash}" Fill="#DC2626" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="清除本机保存的 NAS 密码凭据" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <TextBlock Text="密码使用 Windows DPAPI 加密在当前用户配置中，清除后需要重新输入密码登录。" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,6,0,18"/>

                        <Separator Margin="0,0,0,16"/>

                        <Button Click="BtnSaveGlobalSettings_Click" Style="{StaticResource FluentPrimaryBtn}" Width="150" Height="36" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeoCheck}" Fill="#FFFFFF" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="保存全局设置" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>

        </Grid>
    </Grid>
</Window>
