<Window x:Class="FNSyncPlus.App.AddFolderWizardDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加文件夹备份向导 - 飞牛同步增强版"
        Height="580" Width="820"
        MinHeight="520" MinWidth="760"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBgBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI Variable, sans-serif">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- WIZARD STEP HEADER -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18,12" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="TxtStepTitle" Text="第一步：选择要备份的本地文件夹" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextMainBrush}"/>
                    <TextBlock x:Name="TxtStepDescription" Text="您可以添加一个或多个需要自动保护的本地工作目录（支持拖入文件夹）" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0"/>
                </StackPanel>

                <!-- Step Number Badge Indicator -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="BadgeStep1" Width="28" Height="28" CornerRadius="14" Background="{StaticResource PrimaryAccentBrush}">
                        <TextBlock Text="1" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Rectangle Width="24" Height="2" Fill="#CBD5E1" Margin="4,0"/>
                    <Border x:Name="BadgeStep2" Width="28" Height="28" CornerRadius="14" Background="#E2E8F0">
                        <TextBlock Text="2" Foreground="#64748B" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Rectangle Width="24" Height="2" Fill="#CBD5E1" Margin="4,0"/>
                    <Border x:Name="BadgeStep3" Width="28" Height="28" CornerRadius="14" Background="#E2E8F0">
                        <TextBlock Text="3" Foreground="#64748B" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- WIZARD STEP CONTENT PAGES -->
        <Grid Grid.Row="1">
            <!-- STEP 1: SELECT LOCAL FOLDERS -->
            <Grid x:Name="PageStep1" Visibility="Visible">
                <Border Style="{StaticResource FluentCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Action Toolbar -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="📂 选择本地文件夹..." Click="BtnBrowseFolder_Click" Style="{StaticResource FluentPrimaryBtn}" Height="34"/>
                                <Button Content="🗑️ 清空列表" Click="BtnClearSelectedFolders_Click" Style="{StaticResource FluentSecondaryBtn}" Margin="10,0,0,0" Height="34"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtSelectedFolderCount" Text="已添加 0 个文件夹" FontSize="12" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Folders DataGrid / List -->
                        <DataGrid x:Name="GridSelectedFolders" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                                  BorderBrush="{StaticResource CardBorderBrush}" Background="#FFFFFF" RowHeight="36" HeadersVisibility="Column"
                                  AllowDrop="True" Drop="GridSelectedFolders_Drop" DragOver="GridSelectedFolders_DragOver">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="文件夹名称" Binding="{Binding Name}" FontWeight="Bold" Width="180"/>
                                <DataGridTextColumn Header="本地绝对路径" Binding="{Binding FullPath}" Width="*"/>
                                <DataGridTemplateColumn Header="操作" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="移除" Click="BtnRemoveFolderItem_Click" Style="{StaticResource FluentSecondaryBtn}" Padding="8,2" FontSize="11"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Drag Drop Hint -->
                        <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,10,0,0">
                            <TextBlock Text="💡 提示：您可直接将电脑中的文件夹拖入上方列表中批量添加。多个文件夹将各自创建独立任务，互不干扰。" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- STEP 2: CHOOSE NAS BACKUP ROOT -->
            <Grid x:Name="PageStep2" Visibility="Collapsed">
                <Border Style="{StaticResource FluentCard}">
                    <StackPanel>
                        <TextBlock Text="选择 NAS 上的备份根目录" FontWeight="Bold" FontSize="15" Margin="0,0,0,6"/>
                        <TextBlock Text="所有选中的文件夹将在此根目录下自动创建对应的同名备份文件夹" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,16"/>

                        <!-- NAS Target Root Input -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtNasBackupRoot" Height="36" FontSize="13" Text="" IsReadOnly="True" Background="#F8FAFC"/>
                            <Button Content="🌐 浏览并选择 NAS 目录..." Click="BtnBrowseNasRoot_Click" Style="{StaticResource FluentPrimaryBtn}" Grid.Column="1" Margin="10,0,0,0" Height="36"/>
                        </Grid>

                        <!-- Personal Space Priority Notice -->
                        <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource GeoShield}" Fill="{StaticResource SuccessBrush}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="已优先启用私人备份安全空间" FontWeight="Bold" Foreground="#15803D" FontSize="13"/>
                                </StackPanel>
                                <TextBlock Text="• 软件默认规划个人私有空间目录，绝不强加团队共享文件夹，保障数据隐私安全。" Foreground="#166534" FontSize="12" Margin="24,4,0,0"/>
                                <TextBlock Text="• 您也可随时点击【浏览并选择 NAS 目录】切换为您自选的任意 NAS 共享与子文件夹。" Foreground="#166534" FontSize="12" Margin="24,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Permission & Status Notice -->
                        <Border x:Name="BorderNasRootPermission" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12" Visibility="Collapsed">
                            <TextBlock x:Name="TxtNasRootPermissionMsg" Text="" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- STEP 3: PREVIEW & AUTO-PLANNING -->
            <Grid x:Name="PageStep3" Visibility="Collapsed">
                <Border Style="{StaticResource FluentCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,12">
                            <TextBlock Text="自动规划的任务预览与确认" FontWeight="Bold" FontSize="15"/>
                            <TextBlock Text="已为您自动提取文件夹名称并规划 NAS 备份路径，点击【完成创建】即刻建立任务并开始增量备份" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0"/>
                        </StackPanel>

                        <!-- Preview Planned Tasks Table -->
                        <DataGrid x:Name="GridPlannedTasks" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                                  BorderBrush="{StaticResource CardBorderBrush}" Background="#FFFFFF" RowHeight="38" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="任务名称" Binding="{Binding TaskName}" FontWeight="Bold" Width="140"/>
                                <DataGridTextColumn Header="本地 Windows 源路径" Binding="{Binding SourceFolder}" Width="*"/>
                                <DataGridTextColumn Header="自动规划的 NAS 目标子目录" Binding="{Binding DestinationFolder}" Width="*"/>
                                <DataGridTextColumn Header="规划状态" Binding="{Binding StatusNote}" Foreground="{StaticResource SuccessBrush}" Width="110"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Strategy Options -->
                        <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,12,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <CheckBox x:Name="ChkWizardRealtimeWatch" Content="启用本地变动实时监测" IsChecked="True" FontSize="12" Margin="0,0,16,0"/>
                                    <CheckBox x:Name="ChkWizardAutoInterval" Content="启用定期增量轮询 (5分钟)" IsChecked="True" FontSize="12"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="单向增量模式 (本地删除不删 NAS)" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- WIZARD FOOTER ACTIONS -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Button Content="取消" Click="BtnCancel_Click" Style="{StaticResource FluentSecondaryBtn}" HorizontalAlignment="Left" Width="80" Height="36"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnPrevStep" Content="上一步" Click="BtnPrevStep_Click" Style="{StaticResource FluentSecondaryBtn}" Width="90" Height="36" Margin="0,0,10,0" Visibility="Collapsed"/>
                <Button x:Name="BtnNextStep" Content="下一步" Click="BtnNextStep_Click" Style="{StaticResource FluentPrimaryBtn}" Width="100" Height="36"/>
                <Button x:Name="BtnFinishWizard" Content="✔ 完成并立即创建任务" Click="BtnFinishWizard_Click" Style="{StaticResource FluentPrimaryBtn}" Width="180" Height="36" Visibility="Collapsed"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
