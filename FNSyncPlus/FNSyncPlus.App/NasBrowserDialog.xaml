<Window x:Class="FNSyncPlus.App.NasBrowserDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择 NAS 备份文件夹 - 飞牛同步增强版"
        Height="640" Width="880"
        MinHeight="540" MinWidth="740"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBgBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI Variable, sans-serif">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOP BAR: TITLE + BREADCRUMBS + SEARCH -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header Title & Dismiss -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource GeoCloud}" Fill="{StaticResource PrimaryAccentBrush}" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="NAS 存储资源管理器" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextMainBrush}" VerticalAlignment="Center"/>
                        <Border x:Name="BadgePermission" Background="#DCFCE7" CornerRadius="10" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtPermissionStatus" Text="● 已就绪" FontSize="11" Foreground="#15803D" FontWeight="Medium"/>
                        </Border>
                    </StackPanel>
                    <Button Content="✕" Click="BtnCancel_Click" Style="{StaticResource FluentIconBtn}" HorizontalAlignment="Right" Width="26" Height="26"/>
                </Grid>

                <!-- Navigation Controls -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Click="BtnNasBrowserUp_Click" Style="{StaticResource FluentSecondaryBtn}" Grid.Column="0" Margin="0,0,6,0" Height="32" Padding="10,4">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource GeoUp}" Fill="{StaticResource TextMainBrush}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="返回上一级" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Click="BtnNasBrowserRefresh_Click" Style="{StaticResource FluentSecondaryBtn}" Grid.Column="1" Margin="0,0,6,0" Height="32" Padding="10,4">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource GeoRefresh}" Fill="{StaticResource TextMainBrush}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="刷新" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Path Address Bar -->
                    <TextBox x:Name="TxtNasBrowserCurrentPath" Text="\\" Grid.Column="2" IsReadOnly="True" Background="#F8FAFC" Height="32" Margin="0,0,8,0" VerticalContentAlignment="Center" Padding="8,4" FontSize="12"/>

                    <!-- Search Box -->
                    <Grid Grid.Column="3" Margin="0,0,8,0">
                        <TextBox x:Name="TxtSearchBox" Height="32" Padding="26,4,8,4" TextChanged="TxtSearchBox_TextChanged" VerticalContentAlignment="Center"/>
                        <Path Data="{StaticResource GeoSearch}" Fill="#94A3B8" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="8,0,0,0" IsHitTestVisible="False"/>
                    </Grid>

                    <Button Content="➕ 新建文件夹" Click="BtnNasBrowserNewFolder_Click" Style="{StaticResource FluentPrimaryBtn}" Grid.Column="4" Height="32" Padding="12,4"/>
                </Grid>
            </Grid>
        </Border>

        <!-- MAIN BODY: DUAL PANE -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDEBAR: CATEGORY NAVIGATION -->
            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="位置分类" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSubtleBrush}" Margin="6,2,0,8"/>

                    <StackPanel Grid.Row="1">
                        <RadioButton x:Name="RadioFilterAll" Content="全部共享" Margin="4,4,4,6" FontSize="12" FontWeight="Medium"/>
                        <RadioButton x:Name="RadioFilterPersonal" Content="👤 私人空间 (优先)" Margin="4,4,4,6" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource PrimaryAccentBrush}"/>
                        <RadioButton x:Name="RadioFilterTeam" Content="👥 团队共享文件" Margin="4,4,4,6" FontSize="12" FontWeight="Medium"/>
                    </StackPanel>

                    <!-- Safe Storage Hint -->
                    <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8">
                        <StackPanel>
                            <TextBlock Text="隐私安全提示" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextMainBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="• 私人空间仅当前账号可见&#x0a;• 团队共享全员可访问&#x0a;• 建议个人备份放私人空间" FontSize="10" Foreground="{StaticResource TextMutedBrush}" LineHeight="15" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- RIGHT PANE: FOLDERS LIST -->
            <Border Grid.Column="1" Style="{StaticResource FluentCard}" Padding="4">
                <ListBox x:Name="ListNasBrowserItems" BorderThickness="0" Background="Transparent"
                         MouseDoubleClick="ListNasBrowserItems_MouseDoubleClick" SelectionChanged="ListNasBrowserItems_SelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10,8" Margin="1" Background="Transparent" CornerRadius="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Path Data="{StaticResource GeoFolder}" Fill="#38BDF8" Width="20" Height="20" Stretch="Uniform" Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center"/>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextMainBrush}"/>
                                        <TextBlock Text="{Binding FullUncPath}" Foreground="{StaticResource TextSubtleBrush}" FontSize="11" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <Border Grid.Column="2" Background="#F1F5F9" CornerRadius="4" Padding="6,2" Margin="10,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayCategory}" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                                    </Border>

                                    <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <TextBlock Text="双击进入" Foreground="{StaticResource PrimaryAccentBrush}" FontSize="11" HorizontalAlignment="Right"/>
                                        <TextBlock Text="{Binding LastModified, StringFormat='{}修改: {0:yyyy-MM-dd}'}" Foreground="{StaticResource TextSubtleBrush}" FontSize="10" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Grid>

        <!-- BOTTOM ACTIONS & CALLOUT -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- GUIDANCE CALLOUT (IF NO PERSONAL SHARE) -->
            <Border x:Name="BorderPersonalGuidance" Grid.Row="0" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,10" Visibility="Collapsed">
                <TextBlock x:Name="TxtPersonalGuidance" Text="" FontSize="11" Foreground="#1E40AF" TextWrapping="Wrap"/>
            </Border>

            <!-- BOTTOM STATUS & BUTTONS -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtNasBrowserSelectionHint" Text="提示: 选中或双击进入文件夹，然后点击【选择当前文件夹】" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock x:Name="TxtSecurityNoticeBottom" Text="" FontSize="11" Foreground="{StaticResource PrimaryAccentBrush}" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="取消" Click="BtnCancel_Click" Style="{StaticResource FluentSecondaryBtn}" Width="80" Height="36"/>
                    <Button Content="✔ 选择当前文件夹" Click="BtnSelectFolder_Click" Style="{StaticResource FluentPrimaryBtn}" Margin="10,0,0,0" Width="150" Height="36"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
