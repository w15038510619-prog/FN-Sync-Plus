<Window x:Class="FNSyncPlus.App.TaskLogDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="任务日志详情 - 飞牛同步增强版"
        Height="540" Width="780"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBgBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI Variable, sans-serif">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock x:Name="TxtTaskTitle" Text="任务: 工作资料" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextMainBrush}"/>
                <TextBlock x:Name="TxtTaskPath" Text="D:\工作资料 -> \\192.168.8.120\私人备份\工作资料" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
            </StackPanel>
            <Button Content="✕" Click="BtnClose_Click" Style="{StaticResource FluentIconBtn}" HorizontalAlignment="Right" Width="28" Height="28"/>
        </Grid>

        <!-- LOG CONSOLE BOX -->
        <Border Grid.Row="1" Style="{StaticResource FluentCard}" Background="#0F172A" BorderBrush="#334155" Padding="10">
            <TextBox x:Name="TxtLogOutput" IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     Background="Transparent" Foreground="#38BDF8" BorderThickness="0"
                     FontFamily="Consolas, Cascadia Code, Microsoft YaHei UI" FontSize="12"/>
        </Border>

        <!-- FOOTER ACTIONS -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="🗑️ 清空日志" Click="BtnClearLog_Click" Style="{StaticResource FluentSecondaryBtn}" Height="32"/>
                <Button Content="📄 导出日志文本..." Click="BtnExportLog_Click" Style="{StaticResource FluentSecondaryBtn}" Margin="8,0,0,0" Height="32"/>
            </StackPanel>
            <Button Content="关闭" Click="BtnClose_Click" Style="{StaticResource FluentPrimaryBtn}" HorizontalAlignment="Right" Width="80" Height="32"/>
        </Grid>
    </Grid>
</Window>
