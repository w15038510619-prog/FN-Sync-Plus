<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="FNSyncPlus.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:FNSyncPlus.WinUI.Controls"
    xmlns:vm="using:FNSyncPlus.WinUI.ViewModels"
    Title="飞牛同步增强版"
    mc:Ignorable="d">

    <Grid KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 1. MODERN WINDOWS 11 FLUENT TITLE BAR -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="Transparent" Padding="14,0,144,0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="140" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Drag Region: Brand Icon + Product Name + Subtle Version/Session Tag -->
            <Grid x:Name="AppTitleBarDragArea" Grid.Column="0" Background="Transparent" VerticalAlignment="Stretch">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                    <Image Width="20" Height="20" Source="ms-appx:///Assets/BrandMark.png" Stretch="Uniform" VerticalAlignment="Center" />
                    <TextBlock
                        x:Name="AppTitleText"
                        Text="飞牛同步增强版"
                        FontWeight="SemiBold"
                        FontSize="12"
                        VerticalAlignment="Center"
                        TextTrimming="CharacterEllipsis"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    <Border
                        x:Name="VersionPill"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="4"
                        Padding="6,1"
                        VerticalAlignment="Center">
                        <TextBlock
                            x:Name="AppVersionTag"
                            Text="v0.4.8"
                            FontSize="10"
                            FontWeight="Medium"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Border>
                    <Border
                        x:Name="SessionTagPill"
                        Visibility="Collapsed"
                        Background="{ThemeResource StatusWarningBackgroundBrush}"
                        BorderBrush="{ThemeResource StatusWarningBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="6,1"
                        VerticalAlignment="Center">
                        <TextBlock
                            x:Name="SessionTagText"
                            FontSize="10"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource StatusWarningForegroundBrush}" />
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Right Action Cluster: NAS Status Pill + Update + Help + Theme -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="4">
                <!-- NAS Status Pill -->
                <Button
                    x:Name="BtnNasStatusPill"
                    Click="BtnNasStatusPill_Click"
                    Height="28"
                    Padding="10,0"
                    Margin="0,0,4,0"
                    CornerRadius="14"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    ToolTipService.ToolTip="{x:Bind ViewModel.NasStatusTooltip, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                        <Ellipse x:Name="DotNasStatus" Width="7" Height="7" Fill="#94A3B8" VerticalAlignment="Center" />
                        <TextBlock
                            Text="{x:Bind ViewModel.NasStatusText, Mode=OneWay}"
                            FontSize="11"
                            FontWeight="Medium"
                            MaxWidth="210"
                            TextTrimming="CharacterEllipsis"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </StackPanel>
                </Button>

                <!-- Software Update Trigger + State-Driven Flyout -->
                <Button
                    x:Name="UpdateButton"
                    Style="{StaticResource TitleBarActionButtonStyle}"
                    AutomationProperties.Name="软件更新"
                    ToolTipService.ToolTip="检查与管理软件更新">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Grid VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE895;" FontSize="13" />
                            <Ellipse
                                Width="6"
                                Height="6"
                                Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="0,-2,-2,0"
                                Visibility="{x:Bind Updates.HasUpdateAttention, Mode=OneWay}" />
                        </Grid>
                        <TextBlock Text="{x:Bind Updates.UpdateButtonLabel, Mode=OneWay}" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight">
                            <StackPanel Width="310" Spacing="12" Padding="2">
                                <!-- Header: Status Headline + Version -->
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Text="{x:Bind Updates.UpdateHeadline, Mode=OneWay}"
                                        Style="{StaticResource CardTitleTextStyle}"
                                        TextWrapping="Wrap"
                                        VerticalAlignment="Center" />
                                    <controls:StatusBadge
                                        Grid.Column="1"
                                        Text="{x:Bind Updates.ProductVersion}"
                                        Tone="{x:Bind Updates.UpdateStatusTone, Mode=OneWay}"
                                        ShowDot="False" />
                                </Grid>

                                <!-- Contextual Status Description -->
                                <TextBlock
                                    Text="{x:Bind Updates.UpdateDetailText, Mode=OneWay}"
                                    Style="{StaticResource CardSubtitleTextStyle}"
                                    TextWrapping="Wrap" />

                                <!-- Support Notice (only when updates are restricted/unmanaged) -->
                                <Border
                                    Visibility="{x:Bind Updates.ShowUpdateSupportNotice, Mode=OneWay}"
                                    Style="{StaticResource InsetSurfaceStyle}">
                                    <TextBlock
                                        Text="{x:Bind Updates.UpdateSupportMessage, Mode=OneWay}"
                                        Style="{StaticResource CaptionTextStyle}"
                                        TextWrapping="Wrap" />
                                </Border>

                                <!-- Download Progress (only when downloading) -->
                                <ProgressBar
                                    Value="{x:Bind Updates.DownloadProgress, Mode=OneWay}"
                                    Visibility="{x:Bind Updates.ShowDownloadProgress, Mode=OneWay}"
                                    Height="4" />

                                <!-- State-Driven Action Buttons -->
                                <StackPanel Spacing="8">
                                    <Button
                                        Content="安装并重启…"
                                        Click="InstallUpdate_Click"
                                        Style="{StaticResource PrimaryActionButtonStyle}"
                                        HorizontalAlignment="Stretch"
                                        Visibility="{x:Bind Updates.CanStartInstall, Mode=OneWay}"
                                        IsEnabled="{x:Bind Updates.CanStartInstall, Mode=OneWay}" />

                                    <Button
                                        Content="检查并下载更新"
                                        Command="{x:Bind Updates.DownloadUpdateCommand}"
                                        Style="{StaticResource PrimaryActionButtonStyle}"
                                        HorizontalAlignment="Stretch"
                                        Visibility="{x:Bind Updates.ShowCheckUpdateButton, Mode=OneWay}"
                                        IsEnabled="{x:Bind Updates.CanRunUpdate, Mode=OneWay}" />

                                    <Button
                                        Content="重新检查更新"
                                        Command="{x:Bind Updates.DownloadUpdateCommand}"
                                        Style="{StaticResource SecondaryActionButtonStyle}"
                                        HorizontalAlignment="Stretch"
                                        Visibility="{x:Bind Updates.ShowRecheckUpdateButton, Mode=OneWay}"
                                        IsEnabled="{x:Bind Updates.CanRunUpdate, Mode=OneWay}" />

                                    <Button
                                        Content="取消等待或下载"
                                        Command="{x:Bind Updates.CancelUpdateCommand}"
                                        Style="{StaticResource SecondaryActionButtonStyle}"
                                        HorizontalAlignment="Stretch"
                                        Visibility="{x:Bind Updates.CanCancelUpdate, Mode=OneWay}" />
                                </StackPanel>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <!-- Page Help Trigger -->
                <Button
                    x:Name="BtnHelp"
                    Click="Help_Click"
                    Style="{StaticResource TitleBarActionButtonStyle}"
                    ToolTipService.ToolTip="查看当前页面使用帮助">
                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE897;" FontSize="13" />
                        <TextBlock Text="帮助" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Theme Switcher -->
                <Button
                    x:Name="BtnThemeToggle"
                    Click="BtnThemeToggle_Click"
                    Style="{StaticResource TitleBarActionButtonStyle}"
                    Padding="7,4"
                    ToolTipService.ToolTip="切换深色 / 浅色主题">
                    <FontIcon x:Name="IconThemeToggle" Glyph="&#xE706;" FontSize="13" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- 2. NAVIGATION VIEW SHELL -->
        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            PaneDisplayMode="Auto"
            OpenPaneLength="196"
            ExpandedModeThresholdWidth="1040"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            SelectionChanged="NavView_SelectionChanged">

            <NavigationView.MenuItems>
                <NavigationViewItem Content="同步任务" Tag="Tasks">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B7;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="恢复文件" Tag="Restore">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81C;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="NAS 设备" Tag="Device">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE774;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="设置" Tag="Settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <!-- Content Area inside NavigationView -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <InfoBar
                    x:Name="GlobalInfoBar"
                    Grid.Row="0"
                    IsOpen="{x:Bind ViewModel.IsInfoBarOpen, Mode=TwoWay}"
                    Title="{x:Bind ViewModel.InfoBarTitle, Mode=OneWay}"
                    Message="{x:Bind ViewModel.InfoBarMessage, Mode=OneWay}"
                    Severity="{x:Bind ViewModel.InfoBarSeverity, Mode=OneWay}"
                    Margin="28,8,28,0" />

                <Frame x:Name="ContentFrame" Grid.Row="1" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
