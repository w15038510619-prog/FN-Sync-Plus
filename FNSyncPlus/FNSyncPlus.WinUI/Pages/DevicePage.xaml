<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FNSyncPlus.WinUI.Pages.DevicePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:core="using:FNSyncPlus.Core.Services"
    mc:Ignorable="d">

    <Grid Padding="24,12,24,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 1. HEADER -->
        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock Text="NAS 设备" FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            <TextBlock Text="连接自己的 NAS 账号。" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- 2. TWO-COLUMN LAYOUT -->
        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT: DISCOVERED DEVICES -->
            <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Spacing="4">
                        <TextBlock Text="局域网设备探测" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="通过 mDNS 与端口探测寻找候选设备；登录前请核对自己的飞牛地址和证书。" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Device List -->
                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.DiscoveredDevices, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedDevice, Mode=TwoWay}" SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="8,8" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE753;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding IpAddress}" FontSize="11" FontFamily="Consolas" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <Border Grid.Column="2" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Status}" FontSize="10" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel Grid.Row="2" Spacing="6">
                    <TextBlock Text="{x:Bind ViewModel.DiscoveryMessage, Mode=OneWay}" TextWrapping="Wrap" FontSize="12" />
                    <Button Command="{x:Bind ViewModel.SearchLanDevicesCommand}" HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE72C;" FontSize="12" />
                            <TextBlock Text="搜索设备" FontSize="12" />
                        </StackPanel>
                    </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- RIGHT: AUTHENTICATION FORM & STATUS -->
            <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="24,20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16" HorizontalAlignment="Stretch">
                        <StackPanel Spacing="4">
                            <TextBlock Text="飞牛账号认证与个人空间直连" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="支持我的文件和已授权的团队共享。" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- Connected Status Card -->
                        <Border x:Name="ConnectedCard" Visibility="{x:Bind ViewModel.IsConnected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE73E;" FontSize="15" Foreground="{ThemeResource SystemFillColorSuccessBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="已连接" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource SystemFillColorSuccessBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <Grid ColumnSpacing="8" RowSpacing="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock x:Name="AccountLabel" Grid.Row="0" Grid.Column="0" Text="认证用户:" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="AccountValue" Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.Username, Mode=OneWay}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontSize="11" FontWeight="Medium" FontFamily="Consolas, Segoe UI" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind ViewModel.Username, Mode=OneWay}" />
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="用户 UID:" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="UidValue" Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.CurrentUid, Mode=OneWay}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontSize="11" FontWeight="Medium" FontFamily="Consolas, Segoe UI" />
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="空间根路径:" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="RootValue" Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.PersonalRootDisplay, Mode=OneWay}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontSize="11" FontWeight="Medium" FontFamily="Consolas, Segoe UI" TextWrapping="Wrap" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Button Content="切换账号" Command="{x:Bind ViewModel.SwitchAccountCommand}" Visibility="{x:Bind ViewModel.IsConnected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.ShowLoginForm, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <!-- NAS Address -->
                        <StackPanel Spacing="6" HorizontalAlignment="Left">
                            <TextBlock Text="NAS 主机名 / IP 地址" FontSize="12" FontWeight="Medium" />
                            <TextBox Text="{x:Bind ViewModel.NasAddress, Mode=TwoWay}" PlaceholderText="例如: 192.168.1.100" FontFamily="Consolas, Segoe UI" FontSize="13" />
                        </StackPanel>

                        <!-- Username -->
                        <StackPanel Spacing="6" HorizontalAlignment="Left">
                            <TextBlock Text="飞牛 NAS 用户名" FontSize="12" FontWeight="Medium" />
                            <TextBox Text="{x:Bind ViewModel.Username, Mode=TwoWay}" PlaceholderText="例如: admin 或个人用户名" FontSize="13" />
                        </StackPanel>

                        <!-- Password -->
                        <StackPanel Spacing="6" HorizontalAlignment="Left">
                            <TextBlock Text="密码" FontSize="12" FontWeight="Medium" />
                            <PasswordBox x:Name="TxtPassword" PasswordChanged="TxtPassword_PasswordChanged" PlaceholderText="输入飞牛 NAS 登录密码" FontSize="13" />
                        </StackPanel>

                        <!-- TLS Certificate Confirmation Card (Visible only when untrusted cert is detected) -->
                        <Border Visibility="{x:Bind ViewModel.IsCertConfirmationRequired, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                Background="{ThemeResource SystemFillColorCautionBackgroundBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12" HorizontalAlignment="Left">
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE7BA;" FontSize="16" Foreground="{ThemeResource SystemFillColorCautionBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="核对并信任 NAS 证书" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                </StackPanel>
                                <TextBlock Text="当前 NAS 使用自签名 TLS 证书。为防止中间人攻击，请核对设备证书指纹:" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="8,6">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{x:Bind ViewModel.UntrustedCertFingerprint, Mode=OneWay}" FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind ViewModel.UntrustedCertSubject, Mode=OneWay}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Command="{x:Bind ViewModel.TrustCertificateAndConnectCommand}" Style="{ThemeResource AccentButtonStyle}">
                                        <TextBlock Text="信任并继续连接" FontSize="12" />
                                    </Button>
                                    <Button Command="{x:Bind ViewModel.CancelCertificateTrustCommand}">
                                        <TextBlock Text="取消" FontSize="12" />
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Two Factor Authentication Box (Visible only when required) -->
                        <Border Visibility="{x:Bind ViewModel.TwoFactorRequired, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10">
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8D7;" FontSize="14" Foreground="{ThemeResource SystemFillColorAttentionBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="账号已启用两步验证 (2FA)" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                </StackPanel>
                                <TextBlock Text="请输入身份验证器 App 生成的 6 位动态验证码:" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{x:Bind ViewModel.TwoFactorCode, Mode=TwoWay}" PlaceholderText="例如: 123456" MaxLength="6" FontFamily="Consolas" FontSize="14" />
                                    <Button Grid.Column="1" Command="{x:Bind ViewModel.SubmitTwoFactorCodeCommand}" Style="{ThemeResource AccentButtonStyle}">
                                        <TextBlock Text="验证并登录" FontSize="12" />
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Remember Password -->
                        <CheckBox Content="记住登录信息" IsChecked="{x:Bind ViewModel.RememberPassword, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.CanChangeRememberPassword, Mode=OneWay}" FontSize="12" />

                        <!-- Action Buttons -->
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button Command="{x:Bind ViewModel.LoginCommand}" Style="{ThemeResource AccentButtonStyle}" Padding="16,8">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8D7;" FontSize="13" />
                                    <TextBlock Text="连接" FontSize="12" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>

                            <Button Command="{x:Bind ViewModel.DisconnectCommand}" Padding="14,8">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE71A;" FontSize="13" />
                                    <TextBlock Text="断开当前连接" FontSize="12" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        </StackPanel>
                        <Button Content="断开连接" Command="{x:Bind ViewModel.DisconnectCommand}" Visibility="{x:Bind ViewModel.IsConnected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <!-- Status Message / InfoBar -->
                        <InfoBar

                            HorizontalAlignment="Left"
                            IsOpen="{x:Bind HasStatusMessage(ViewModel.ConnectionMessage), Mode=OneWay}"
                            Severity="{x:Bind GetSeverity(ViewModel.ConnectionHealthy), Mode=OneWay}"
                            Title="{x:Bind GetStatusTitle(ViewModel.ConnectionHealthy), Mode=OneWay}"
                            Message="{x:Bind ViewModel.ConnectionMessage, Mode=OneWay}"
                            IsClosable="False" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
