<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FNSyncPlus.WinUI.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24,12,24,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 1. HEADER -->
        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock Text="系统与同步设置" FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            <TextBlock Text="自定义软件自启动、后台运行、多任务并发控制及安全凭据管理" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- 2. SETTINGS CONTENT -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16" MaxWidth="720" HorizontalAlignment="Left">
                <!-- Card 1: System Behavior -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="系统运行行为" FontSize="14" FontWeight="SemiBold" />

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="开机自动启动" FontSize="13" FontWeight="Medium" />
                                <TextBlock Text="随 Windows 开机在后台启动；试用或测试配置暂不支持此选项" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.StartWithWindows, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.CanConfigureStartup}" OnContent="" OffContent="" />
                        </Grid>

                        <MenuFlyoutSeparator Margin="0,4" />

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="关闭主窗口时最小化到系统托盘" FontSize="13" FontWeight="Medium" />
                                <TextBlock Text="点击窗口右上角关闭按钮时保持后台同步运行，双击托盘图标可重新呼出" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.MinimizeToTray, Mode=TwoWay}" OnContent="" OffContent="" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Card 2: Performance & Concurrency -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="性能与并发控制" FontSize="14" FontWeight="SemiBold" />

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="180" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="最大并发同步任务数" FontSize="13" FontWeight="Medium" />
                                <TextBlock Text="限制同时向 NAS 传输文件的任务数量，防止网络带宽与 NAS 存储 I/O 拥塞" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" SelectedIndex="{x:Bind ViewModel.MaxConcurrentSyncsIndex, Mode=TwoWay}" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="1 个任务 (低负载)" />
                                <ComboBoxItem Content="2 个任务 (推荐平衡)" />
                                <ComboBoxItem Content="3 个任务 (高性能)" />
                                <ComboBoxItem Content="4 个任务 (千兆/万兆)" />
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Card 3: Security & Credentials -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="安全与凭据管理" FontSize="14" FontWeight="SemiBold" />

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="清除已保存的密码" FontSize="13" FontWeight="Medium" />
                                <TextBlock Text="密码使用 Windows DPAPI 本地强加密存储。点击可立即清除所有记住的凭据" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <Button Grid.Column="1" Command="{x:Bind ViewModel.ClearCredentialsCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                    <TextBlock Text="清除 DPAPI 凭据" FontSize="12" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Card 4: Backup capacity & retention (read-only) -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="备份容量与保留策略（只读）" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="统计当前备份、历史版本与物理对象的占用。程序不会自动删除任何历史版本；预览仅用于人工评估。"
                                   FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="240" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="备份任务" FontSize="13" FontWeight="Medium" />
                                <TextBlock Text="选择要统计的备份目标（需先连接 NAS）" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.CapacityTasks, Mode=OneWay}"
                                      SelectedIndex="{x:Bind ViewModel.CapacityTaskIndex, Mode=TwoWay}" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Command="{x:Bind ViewModel.AnalyzeCapacityCommand}" IsEnabled="{x:Bind ViewModel.CanRunCapacity, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE9D9;" FontSize="12" />
                                    <TextBlock Text="统计容量" FontSize="12" />
                                </StackPanel>
                            </Button>
                            <NumberBox Value="{x:Bind ViewModel.RetentionKeepVersions, Mode=TwoWay}" Minimum="1" Maximum="1000" SmallChange="1"
                                       SpinButtonPlacementMode="Compact" Width="120" Header="保留版本数" />
                            <NumberBox Value="{x:Bind ViewModel.RetentionKeepDays, Mode=TwoWay}" Minimum="0" Maximum="3650" SmallChange="1"
                                       SpinButtonPlacementMode="Compact" Width="120" Header="保留天数" />
                            <Button Command="{x:Bind ViewModel.PreviewRetentionCommand}" IsEnabled="{x:Bind ViewModel.CanRunCapacity, Mode=OneWay}"
                                    VerticalAlignment="Bottom">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE81C;" FontSize="12" />
                                    <TextBlock Text="预览保留策略" FontSize="12" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <TextBlock Text="{x:Bind ViewModel.CapacitySummary, Mode=OneWay}" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsTextSelectionEnabled="True" />
                        <TextBlock Text="{x:Bind ViewModel.RetentionSummary, Mode=OneWay}" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsTextSelectionEnabled="True" />
                    </StackPanel>
                </Border>

                <!-- Card 5: Software Update -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="软件更新" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.CurrentVersionText, Mode=OneWay}" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock Text="{x:Bind ViewModel.UpdateSupportMessage, Mode=OneWay}" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="200" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="更新源地址（HTTPS）" FontSize="13" FontWeight="Medium" />
                                <TextBlock Text="公司内网更新服务器的清单地址，例如 https://update.example.internal/fnsync/manifest.json" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <TextBox Grid.Column="1" Text="{x:Bind ViewModel.UpdateFeedUrl, Mode=TwoWay}" FontSize="11" PlaceholderText="https://…/manifest.json" />
                        </Grid>

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="200" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="更新通道" FontSize="13" FontWeight="Medium" />
                                <TextBlock Text="Stable 只接收正式版；Beta 可接收测试版。请按公司试点范围选择" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" SelectedIndex="{x:Bind ViewModel.UpdateChannelIndex, Mode=TwoWay}" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="Stable（正式）" />
                                <ComboBoxItem Content="Beta（试点）" />
                            </ComboBox>
                        </Grid>

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="200" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="更新方式" FontSize="13" FontWeight="Medium" />
                                <TextBlock Text="无人值守安装需要先通过安全验收；否则请保持“仅检查”" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" SelectedIndex="{x:Bind ViewModel.UpdateModeIndex, Mode=TwoWay}" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="仅检查更新" />
                                <ComboBoxItem Content="下载后提示" />
                                <ComboBoxItem Content="无人值守安装" />
                            </ComboBox>
                        </Grid>

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="允许无人值守安装" FontSize="13" FontWeight="Medium" />
                                <TextBlock Text="仅在测试环境验证通过、且公司明确批准后启用。备份进行中会推迟安装，不会中断备份" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.UnattendedEnabled, Mode=TwoWay}"
                                          IsEnabled="{x:Bind ViewModel.UnattendedSelectable, Mode=OneWay}" OnContent="" OffContent="" />
                        </Grid>

                        <ProgressBar IsIndeterminate="True"
                                     Visibility="{x:Bind ViewModel.ShowDownloadProgress, Mode=OneWay}" Height="4" />

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Command="{x:Bind ViewModel.CheckUpdateCommand}" IsEnabled="{x:Bind ViewModel.CanCheckUpdate, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE895;" FontSize="12" />
                                    <TextBlock Text="检查更新" FontSize="12" />
                                </StackPanel>
                            </Button>
                            <Button Command="{x:Bind ViewModel.DownloadUpdateCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE896;" FontSize="12" />
                                    <TextBlock Text="下载更新包" FontSize="12" />
                                </StackPanel>
                            </Button>
                            <Button Command="{x:Bind ViewModel.InstallUpdateCommand}" IsEnabled="{x:Bind ViewModel.CanInstallUpdate, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE777;" FontSize="12" />
                                    <TextBlock Text="安装并重启" FontSize="12" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <TextBlock Text="{x:Bind ViewModel.UpdateStatus, Mode=OneWay}" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.LastCheckText, Mode=OneWay}" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.InstallBlockedReason, Mode=OneWay}" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <!-- P0-2：后台调度是真实运行的，这里显示它最近一次的动作，避免"设置项存在但没有调度" -->
                        <TextBlock Text="{x:Bind ViewModel.AutoCheckStatus, Mode=OneWay}" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Card 5: About & Version -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="关于软件与版本信息" FontSize="14" FontWeight="SemiBold" />
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="飞牛同步增强版 (FN Sync Plus)" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Text="测试构建版本：v0.4.0-beta (Windows App SDK / WinUI 3 原生桌面架构)" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="注：当前阶段为 Beta 测试版，提供长文件名无损映射、多任务隔离、内置备份测试实验室等功能。" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Border Grid.Column="1" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                                <TextBlock Text="v0.4.0-beta" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Action Bar -->
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Command="{x:Bind ViewModel.SaveSettingsCommand}" Style="{ThemeResource AccentButtonStyle}" Padding="20,8">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE74E;" FontSize="13" />
                            <TextBlock Text="保存设置变更" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Status Feedback InfoBar -->
                <InfoBar
                    IsOpen="{x:Bind HasNotice(ViewModel.StatusNotice), Mode=OneWay}"
                    Severity="Success"
                    Title="操作结果"
                    Message="{x:Bind ViewModel.StatusNotice, Mode=OneWay}"
                    IsClosable="True" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
