<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FNSyncPlus.WinUI.Pages.TestLabPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:FNSyncPlus.WinUI.ViewModels"
    mc:Ignorable="d">

    <Grid Padding="24,12,24,20" RowSpacing="14">
        <Grid.RowDefinitions>
            <!-- 0: HEADER -->
            <RowDefinition Height="Auto" />
            <!-- 1: CONTROL BAR -->
            <RowDefinition Height="Auto" />
            <!-- 2: MAIN WORKSPACE -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 0. HEADER -->
        <Border Grid.Row="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="备份测试实验室 (Test Lab)" FontSize="18" FontWeight="SemiBold" />
                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                            <TextBlock Text="v0.4.0-beta 内置验证系统" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontWeight="Medium" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="安全沙箱环境自动化生成 254/255/256/300 字节临界文件，验证短名无损映射、多任务隔离与 SHA-256 逐字节完整性恢复。" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button Command="{x:Bind ViewModel.GenerateSamplesCommand}" Padding="14,7">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE756;" FontSize="12" />
                            <TextBlock Text="生成测试样本集" FontSize="12" />
                        </StackPanel>
                    </Button>

                    <Button Command="{x:Bind ViewModel.RunTestCommand}" Style="{ThemeResource AccentButtonStyle}" Padding="16,7">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE768;" FontSize="13" />
                            <TextBlock Text="启动自动化测试" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>

                    <Button Command="{x:Bind ViewModel.ExportReportCommand}" IsEnabled="{x:Bind ViewModel.HasReport, Mode=OneWay}" Padding="12,7">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE74E;" FontSize="12" />
                            <TextBlock Text="导出测试报告" FontSize="12" />
                        </StackPanel>
                    </Button>

                    <Button Command="{x:Bind ViewModel.RunRestoreCenterSuiteCommand}" Padding="12,7" ToolTipService.ToolTip="在本地隔离目录运行名称、历史、损坏、安全与取消场景的恢复套件">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE777;" FontSize="12" />
                            <TextBlock Text="恢复中心套件" FontSize="12" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 1. CONTROL CONFIGURATION BAR -->
        <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Test Mode Selector -->
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="测试运行模式" FontSize="11" FontWeight="Medium" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ComboBox SelectedIndex="{x:Bind ViewModel.SelectedModeIndex, Mode=TwoWay}" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="1. 本地独立临时目录测试" />
                        <ComboBoxItem Content="2. 真实飞牛 NAS 个人空间端到端测试" />
                        <ComboBoxItem Content="3. 真实飞牛 NAS SMB 网络共享测试" />
                    </ComboBox>
                </StackPanel>

                <!-- Target NAS Share (for Mode 2) -->
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="真实测试：请填写已授权的测试父目录（测试子目录将保留）" FontSize="11" FontWeight="Medium" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBox Text="{x:Bind ViewModel.TargetNasShare, Mode=TwoWay}" PlaceholderText="个人空间：我的文件/测试目录；SMB：\\服务器\共享\测试目录" FontFamily="Consolas, Segoe UI" FontSize="12" />
                </StackPanel>

                <!-- Status Text -->
                <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" TextWrapping="Wrap" MaxWidth="320" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. MAIN WORKSPACE WITH TABS: RESULTS / SAMPLES / LOGS -->
        <TabView Grid.Row="2">
            <!-- TAB 1: TEST RESULTS & INTEGRITY REPORT -->
            <TabViewItem Header="测试报告与哈希比对" IsClosable="False">
                <Grid Padding="0,10,0,0" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <!-- Verdict Card -->
                        <RowDefinition Height="Auto" />
                        <!-- Verification Table -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Verdict Card -->
                    <Border Grid.Row="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="6">
                                <TextBlock Text="{x:Bind ViewModel.ReportVerdictText, Mode=OneWay}" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind ViewModel.ReportStatsSummary, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <Border Grid.Column="1" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="10,6" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.TestElapsedSeconds, Mode=OneWay}" FontSize="12" FontFamily="Consolas" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Verification Table -->
                    <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Padding="8,4" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.5*" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="1.5*" />
                                    <ColumnDefinition Width="1.5*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="文件相对路径" FontSize="11" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="UTF-8 字节" FontSize="11" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="2" Text="长名映射" FontSize="11" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="3" Text="判定结果" FontSize="11" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="4" Text="源 SHA-256" FontSize="11" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="5" Text="还原 SHA-256" FontSize="11" FontWeight="SemiBold" />
                            </Grid>

                            <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.VerificationResults, Mode=OneWay}" SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="8,6" Margin="0,1" CornerRadius="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2.5*" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="130" />
                                                <ColumnDefinition Width="1.5*" />
                                                <ColumnDefinition Width="1.5*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding RelativePath}" FontSize="11" FontFamily="Consolas, Segoe UI" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Utf8Bytes}" FontSize="11" FontFamily="Consolas" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding WasMapped}" FontSize="11" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="{Binding StatusMessage}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="4" Text="{Binding OriginalSha256}" FontSize="10" FontFamily="Consolas" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="5" Text="{Binding RestoredSha256}" FontSize="10" FontFamily="Consolas" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>
                </Grid>
            </TabViewItem>

            <!-- TAB 2: GENERATED SAMPLES INSPECTOR -->
            <TabViewItem Header="样本集详情" IsClosable="False">
                <Border Padding="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Margin="0,10,0,0">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Padding="8,4" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="测试文件路径" FontSize="11" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="测试类别" FontSize="11" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="2" Text="UTF-8 字节" FontSize="11" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="3" Text="触发映射" FontSize="11" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="4" Text="文件大小" FontSize="11" FontWeight="SemiBold" />
                        </Grid>

                        <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.GeneratedSamples, Mode=OneWay}" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="8,6" Margin="0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3*" />
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="2*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding RelativePath}" FontSize="11" FontFamily="Consolas, Segoe UI" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Category}" FontSize="11" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding Utf8ByteCount}" FontSize="11" FontFamily="Consolas" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="{Binding RequiresMapping}" FontSize="11" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="4" Text="{Binding FileSizeBytes}" FontSize="11" FontFamily="Consolas" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </TabViewItem>

            <!-- TAB 3: REAL-TIME EXECUTION LOG -->
            <TabViewItem Header="实时执行日志" IsClosable="False">
                <Border Padding="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Margin="0,10,0,0">
                    <ListView ItemsSource="{x:Bind ViewModel.ExecutionLogs, Mode=OneWay}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="11" FontFamily="Consolas, Cascadia Code" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Margin="0,2" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>
            </TabViewItem>
        </TabView>
    </Grid>
</Page>
