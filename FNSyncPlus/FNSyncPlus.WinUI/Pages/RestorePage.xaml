<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="FNSyncPlus.WinUI.Pages.RestorePage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="using:FNSyncPlus.WinUI.ViewModels">
 <Grid Padding="24,12,24,20" RowSpacing="10">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="恢复文件" FontSize="22" FontWeight="SemiBold"/>
  <Border Grid.Row="1" Padding="14" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
   <StackPanel Spacing="8">
    <TextBlock Text="选择备份" FontWeight="SemiBold"/>
    <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <ComboBox ItemsSource="{x:Bind ViewModel.DiscoveredPackages}" SelectedItem="{x:Bind ViewModel.SelectedPackage, Mode=TwoWay}" HorizontalAlignment="Stretch" PlaceholderText="连接 NAS 后自动显示备份" IsEnabled="{x:Bind ViewModel.CanConfigureRestore, Mode=OneWay}">
      <ComboBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding PackageName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Summary}" FontSize="11" TextWrapping="Wrap" ToolTipService.ToolTip="{Binding NasFolderUnc}"/></StackPanel></DataTemplate></ComboBox.ItemTemplate>
     </ComboBox>
     <Button Grid.Column="1" Content="刷新" Command="{x:Bind ViewModel.LoadKnownBackupsCommand}"/>
    </Grid>
    <Expander IsExpanded="{x:Bind ViewModel.OtherLocationsExpanded, Mode=TwoWay}" Header="浏览其他备份位置" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
     <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBox Text="{x:Bind ViewModel.NasScanRoot, Mode=TwoWay}" PlaceholderText="通过右侧浏览按钮选择"/>
      <Button Grid.Column="1" Content="浏览…" Click="BtnBrowseNasRestore_Click"/>
      <Button Grid.Column="2" Content="打开" Command="{x:Bind ViewModel.ScanPackagesCommand}"/>
     </Grid>
    </Expander>
   </StackPanel>
  </Border>
  <Grid Grid.Row="2" RowSpacing="6">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <TextBox Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="搜索文件名或文件夹"/>
   <Pivot Grid.Row="1" x:Name="RestoreTabs" SelectionChanged="RestoreTabs_SelectionChanged">
    <PivotItem Header="恢复最新文件">
     <Grid RowSpacing="6"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <Button Content="上一级" Command="{x:Bind ViewModel.FolderUpCommand}"/>
       <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.CurrentFolder, Mode=OneWay}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
       <ComboBox Grid.Column="2" ItemsSource="{x:Bind ViewModel.Folders}" PlaceholderText="打开子文件夹" SelectionChanged="Folder_SelectionChanged" MaxWidth="260"/>
      </Grid>
      <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.VisibleFiles}" SelectionMode="Multiple" SelectionChanged="Files_SelectionChanged" IsEnabled="{x:Bind ViewModel.CanConfigureRestore, Mode=OneWay}">
       <ListView.ItemTemplate><DataTemplate x:DataType="vm:RestoreFileDisplayItem"><StackPanel Padding="4"><TextBlock Text="{x:Bind OriginalRelPath}" TextWrapping="Wrap" ToolTipService.ToolTip="{x:Bind OriginalRelPath}"/><TextBlock Text="{x:Bind FormattedSize}" FontSize="11"/></StackPanel></DataTemplate></ListView.ItemTemplate>
      </ListView>
     </Grid>
    </PivotItem>
    <PivotItem Header="恢复历史版本">
     <Grid RowSpacing="6"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <CalendarDatePicker Date="{x:Bind ViewModel.HistoryDate, Mode=TwoWay}" PlaceholderText="按日期筛选（可清除）"/>
      <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.VisibleHistory}" SelectionMode="Multiple" SelectionChanged="History_SelectionChanged" IsEnabled="{x:Bind ViewModel.CanConfigureRestore, Mode=OneWay}">
       <ListView.ItemTemplate><DataTemplate x:DataType="vm:RestoreHistoryDisplayItem"><StackPanel Padding="4"><TextBlock Text="{x:Bind DisplayPath}" TextWrapping="Wrap" ToolTipService.ToolTip="{x:Bind DisplayPath}"/><StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="{x:Bind ArchivedAt}" FontSize="11"/><TextBlock Text="{x:Bind Reason}" FontSize="11"/><TextBlock Text="{x:Bind Size}" FontSize="11"/></StackPanel></StackPanel></DataTemplate></ListView.ItemTemplate>
      </ListView>
      <Button Grid.Row="2" Content="{x:Bind ViewModel.HistoryRestoreLabel, Mode=OneWay}" Click="BeginRestore_Click" IsEnabled="{x:Bind ViewModel.CanConfigureRestore, Mode=OneWay}"/>
     </Grid>
    </PivotItem>
   </Pivot>
  </Grid>
  <Border Grid.Row="3" Padding="14" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
   <StackPanel Spacing="8">
    <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBox Header="恢复到" Text="{x:Bind ViewModel.LocalRestoreTarget, Mode=TwoWay}" IsReadOnly="True" ToolTipService.ToolTip="{x:Bind ViewModel.LocalRestoreTarget, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.CanConfigureRestore, Mode=OneWay}"/>
     <Button Grid.Column="1" Content="选择文件夹…" Click="BtnBrowseLocalRestore_Click" VerticalAlignment="Bottom" IsEnabled="{x:Bind ViewModel.CanConfigureRestore, Mode=OneWay}"/>
    </Grid>
    <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <ComboBox SelectedIndex="{x:Bind ViewModel.ConflictPolicyIndex, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.CanConfigureRestore, Mode=OneWay}"><ComboBoxItem Content="同名文件跳过"/><ComboBoxItem Content="覆盖同名文件（需要确认）"/><ComboBoxItem Content="保留两份，自动改名"/></ComboBox>
     <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
      <Button Content="取消" Command="{x:Bind ViewModel.CancelRestoreCommand}" Visibility="{x:Bind ViewModel.IsRestoring, Mode=OneWay}"/>
      <StackPanel x:Name="CurrentRestoreActions" Orientation="Horizontal" Spacing="8"><Button x:Name="RetryRestoreButton" Content="重试失败文件" Click="BeginRestore_Click" IsEnabled="{x:Bind ViewModel.CanRetryCurrentRestore, Mode=OneWay}"/><Button Content="{x:Bind ViewModel.CurrentRestoreLabel, Mode=OneWay}" Click="BeginRestore_Click" Style="{ThemeResource AccentButtonStyle}" IsEnabled="{x:Bind ViewModel.CanConfigureRestore, Mode=OneWay}"/></StackPanel>
     </StackPanel>
    </Grid>
    <ProgressBar Value="{x:Bind ViewModel.RestoreProgress, Mode=OneWay}" Height="4"/>
    <TextBlock Text="{x:Bind ViewModel.RestoreStatusText, Mode=OneWay}" TextWrapping="Wrap" MaxLines="2"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock FontSize="12"><Run Text="成功 "/><Run Text="{x:Bind ViewModel.RestoredFilesCount, Mode=OneWay}"/><Run Text="  已校验 "/><Run Text="{x:Bind ViewModel.IntegrityVerifiedCount, Mode=OneWay}"/><Run Text="  失败 "/><Run Text="{x:Bind ViewModel.FailedFilesCount, Mode=OneWay}"/><Run Text="  跳过 "/><Run Text="{x:Bind ViewModel.SkippedFilesCount, Mode=OneWay}"/></TextBlock><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"><Button Content="高级详情" Click="Details_Click"/><Button Content="导出报告" Command="{x:Bind ViewModel.ExportRestoreLogCommand}"/></StackPanel></Grid>
   </StackPanel>
  </Border>
 </Grid>
</Page>
