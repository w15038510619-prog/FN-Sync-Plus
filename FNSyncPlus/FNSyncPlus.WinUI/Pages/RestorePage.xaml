<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="FNSyncPlus.WinUI.Pages.RestorePage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="using:FNSyncPlus.WinUI.ViewModels">
 <Grid Padding="24,12,24,20" RowSpacing="10">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="恢复文件" FontSize="22" FontWeight="SemiBold"/>
  <Border Grid.Row="1" Padding="14" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
   <StackPanel Spacing="8">
    <TextBlock Text="选择备份" FontWeight="SemiBold"/>
    <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <ComboBox ItemsSource="{x:Bind ViewModel.DiscoveredPackages}" SelectedItem="{x:Bind ViewModel.SelectedPackage, Mode=TwoWay}" HorizontalAlignment="Stretch" PlaceholderText="连接 NAS 后自动显示备份" IsEnabled="{x:Bind ViewModel.CanConfigureRestore, Mode=OneWay}">
      <ComboBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding PackageName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Summary}" FontSize="11" TextWrapping="Wrap" ToolTipService.ToolTip="{Binding NasFolderUnc}"/></StackPanel></DataTemplate></ComboBox.ItemTemplate>
     </ComboBox>
     <Button Grid.Column="1" Content="刷新" Command="{x:Bind ViewModel.LoadKnownBackupsCommand}"/>
     <Button Grid.Column="2" Content="浏览备份…" ToolTipService.ToolTip="浏览其他备份位置" Click="BtnBrowseNasRestore_Click"/>
    </Grid>
   </StackPanel>
  </Border>
  <Grid Grid.Row="2" RowSpacing="6">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid ColumnSpacing="12">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <SelectorBar x:Name="RestoreMode" SelectionChanged="RestoreMode_SelectionChanged">
     <SelectorBarItem Text="恢复最新文件" IsSelected="True"/>
     <SelectorBarItem Text="恢复历史版本"/>
    </SelectorBar>
    <TextBox Grid.Column="1" VerticalAlignment="Center" Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="搜索整个备份" AutomationProperties.Name="搜索整个备份"/>
   </Grid>
   <Grid Grid.Row="1" ColumnSpacing="8">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Button Content="上一级" Command="{x:Bind ViewModel.FolderUpCommand}" IsEnabled="{x:Bind ViewModel.CanGoUp, Mode=OneWay}"/>
    <ScrollViewer Grid.Column="1" HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
     <ItemsControl ItemsSource="{x:Bind ViewModel.Breadcrumbs}">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:RestoreBrowserItem">
       <Button Tag="{x:Bind}" Click="OpenFolder_Click" ToolTipService.ToolTip="{x:Bind DisplayPath}" MaxWidth="240">
        <TextBlock Text="{x:Bind BreadcrumbLabel}" TextTrimming="CharacterEllipsis"/>
       </Button>
      </DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
    </ScrollViewer>
   </Grid>
   <Grid Grid.Row="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
    <ListView x:Name="CurrentFileList" ItemsSource="{x:Bind ViewModel.BrowserItems}" SelectionMode="None" IsItemClickEnabled="True"
              ItemClick="Browser_ItemClick" KeyDown="Browser_KeyDown" IsEnabled="{x:Bind ViewModel.CanConfigureRestore, Mode=OneWay}" AutomationProperties.Name="备份文件和文件夹">
     <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="MinHeight" Value="34"/></Style></ListView.ItemContainerStyle>
     <ListView.ItemTemplate><DataTemplate x:DataType="vm:RestoreBrowserItem">
      <Grid ColumnSpacing="8" DoubleTapped="BrowserRow_DoubleTapped" DataContext="{x:Bind}">
       <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <CheckBox MinWidth="0" Padding="0" Tag="{x:Bind}" IsChecked="{x:Bind IsChecked, Mode=OneWay}" Click="BrowserCheck_Click"
                 Visibility="{x:Bind CanCheck, Mode=OneWay}" AutomationProperties.Name="{x:Bind DisplayPath}"/>
       <FontIcon Grid.Column="1" Glyph="{x:Bind Icon}" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
       <StackPanel Grid.Column="2" VerticalAlignment="Center" Padding="0,3">
        <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind DisplayPath}"/>
        <TextBlock Text="{x:Bind DisplayLocation}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"
                   Visibility="{x:Bind ShowLocation, Mode=OneWay}"/>
       </StackPanel>
       <Button Grid.Column="3" Content="›" Tag="{x:Bind}" Click="OpenFolder_Click" AutomationProperties.Name="打开文件夹" ToolTipService.ToolTip="打开文件夹"
               Visibility="{x:Bind IsFolder, Converter={StaticResource BoolToVisibilityConverter}}" Padding="8,0"/>
      </Grid>
     </DataTemplate></ListView.ItemTemplate>
    </ListView>
    <TextBlock Text="{x:Bind ViewModel.BrowserMessage, Mode=OneWay}" Visibility="{x:Bind ViewModel.ShowBrowserMessage, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
   </Grid>
   <StackPanel Grid.Row="3" Spacing="4" Visibility="{x:Bind ViewModel.IsHistoryMode, Mode=OneWay}">
    <TextBlock Text="{x:Bind ViewModel.HistoryCaption, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind ViewModel.HistoryCaption, Mode=OneWay}"/>
    <ListView x:Name="HistoryFileList" MaxHeight="108" ItemsSource="{x:Bind ViewModel.VisibleHistory}" SelectedItem="{x:Bind ViewModel.SelectedHistory, Mode=TwoWay}"
              SelectionMode="Single" IsEnabled="{x:Bind ViewModel.CanConfigureRestore, Mode=OneWay}" AutomationProperties.Name="文件历史版本">
     <ListView.ItemTemplate><DataTemplate x:DataType="vm:RestoreHistoryDisplayItem"><StackPanel Orientation="Horizontal" Spacing="12" Padding="4">
      <TextBlock Text="{x:Bind ArchivedAt}"/><TextBlock Text="{x:Bind Reason}"/><TextBlock Text="{x:Bind Size}"/>
     </StackPanel></DataTemplate></ListView.ItemTemplate>
    </ListView>
   </StackPanel>
  </Grid>
  <Border Grid.Row="3" Padding="12,8" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
   <StackPanel Spacing="6">
    <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock Text="恢复到" VerticalAlignment="Center"/>
     <TextBox Grid.Column="1" Text="{x:Bind ViewModel.LocalRestoreTarget, Mode=TwoWay}" IsReadOnly="True" ToolTipService.ToolTip="{x:Bind ViewModel.LocalRestoreTarget, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.CanConfigureRestore, Mode=OneWay}"/>
     <Button Grid.Column="2" Content="选择文件夹…" Click="BtnBrowseLocalRestore_Click" IsEnabled="{x:Bind ViewModel.CanConfigureRestore, Mode=OneWay}"/>
    </Grid>
    <Grid ColumnSpacing="8">
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <ComboBox SelectedIndex="{x:Bind ViewModel.ConflictPolicyIndex, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.CanConfigureRestore, Mode=OneWay}"><ComboBoxItem Content="同名文件跳过"/><ComboBoxItem Content="覆盖同名文件（需要确认）"/><ComboBoxItem Content="保留两份，自动改名"/></ComboBox>
     <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SelectionSummary, Mode=OneWay}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                ToolTipService.ToolTip="{x:Bind ViewModel.SelectionSummary, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsHistoryMode, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
     <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
      <Button Content="取消恢复" Command="{x:Bind ViewModel.CancelRestoreCommand}" Visibility="{x:Bind ViewModel.IsRestoring, Mode=OneWay}"/>
      <StackPanel x:Name="CurrentRestoreActions" Orientation="Horizontal" Spacing="8" Visibility="{x:Bind ViewModel.IsHistoryMode, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
      <Button x:Name="RetryRestoreButton" Content="重试失败文件" Click="BeginRestore_Click" Visibility="{x:Bind ViewModel.CanRetryCurrentRestore, Mode=OneWay}"/>
      <Button x:Name="RestoreEntireButton" Content="恢复整个备份" Click="BeginRestore_Click" IsEnabled="{x:Bind ViewModel.CanRestoreEntireBackup, Mode=OneWay}"/>
      <Button Content="恢复所选" Click="BeginRestore_Click" Style="{ThemeResource AccentButtonStyle}" IsEnabled="{x:Bind ViewModel.CanRestoreSelection, Mode=OneWay}"/>
      </StackPanel>
      <Button x:Name="HistoryRestoreAction" Content="恢复所选版本" Visibility="{x:Bind ViewModel.IsHistoryMode, Mode=OneWay}"
             Click="BeginRestore_Click" Style="{ThemeResource AccentButtonStyle}" IsEnabled="{x:Bind ViewModel.CanRestoreHistory, Mode=OneWay}"/>
     </StackPanel>
    </Grid>
    <ProgressBar Value="{x:Bind ViewModel.RestoreProgress, Mode=OneWay}" Height="4"/>
    <TextBlock Text="{x:Bind ViewModel.RestoreStatusText, Mode=OneWay}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind ViewModel.RestoreStatusText, Mode=OneWay}"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock FontSize="12"><Run Text="成功 "/><Run Text="{x:Bind ViewModel.RestoredFilesCount, Mode=OneWay}"/><Run Text="  已校验 "/><Run Text="{x:Bind ViewModel.IntegrityVerifiedCount, Mode=OneWay}"/><Run Text="  失败 "/><Run Text="{x:Bind ViewModel.FailedFilesCount, Mode=OneWay}"/><Run Text="  跳过 "/><Run Text="{x:Bind ViewModel.SkippedFilesCount, Mode=OneWay}"/></TextBlock><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"><Button Content="高级详情" Click="Details_Click"/><Button Content="导出报告" Command="{x:Bind ViewModel.ExportRestoreLogCommand}"/></StackPanel></Grid>
   </StackPanel>
  </Border>
 </Grid>
</Page>
