<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FNSyncPlus.WinUI.Pages.RestorePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:FNSyncPlus.WinUI.ViewModels"
    mc:Ignorable="d">

    <Grid Padding="24,12,24,24" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. HEADER -->
        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock Text="异机无损恢复中心" FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            <TextBlock Text="无需原电脑本地数据库；选择备份目录或其上一级目录，恢复时逐一校验 SHA-256。" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
        </StackPanel>

        <!-- 2. SCAN NAS ROOT & SELECT PACKAGE -->
        <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16,12">
            <Grid RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Scan Row -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="NAS 备份位置:" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <TextBox Grid.Column="1" Text="{x:Bind ViewModel.NasScanRoot, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.CanConfigureRestore, Mode=OneWay}" FontFamily="Consolas, Segoe UI" FontSize="12" VerticalAlignment="Center" />
                    <Button Grid.Column="2" Click="BtnBrowseNasRestore_Click" IsEnabled="{x:Bind ViewModel.CanConfigureRestore, Mode=OneWay}" Content="选择目录" Margin="10,0,0,0" />
                    <Button Grid.Column="3" Command="{x:Bind ViewModel.ScanPackagesCommand}" IsEnabled="{x:Bind ViewModel.CanConfigureRestore, Mode=OneWay}" Style="{ThemeResource AccentButtonStyle}" Margin="10,0,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE721;" FontSize="12" />
                            <TextBlock Text="检索备份包" FontSize="12" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Package Dropdown -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="选择备份任务:" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <ComboBox
                        Grid.Column="1"
                        ItemsSource="{x:Bind ViewModel.DiscoveredPackages, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.SelectedPackage, Mode=TwoWay}"
                        IsEnabled="{x:Bind ViewModel.CanConfigureRestore, Mode=OneWay}"
                        HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding PackageName}" FontSize="12" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>
            </Grid>
        </Border>

        <!-- 3. RESTORABLE FILES LIST -->
        <Border Grid.Row="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
            <Pivot>
              <PivotItem Header="当前文件">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Column Headers -->
                <Grid Grid.Row="0" Background="{ThemeResource SubtleFillColorSecondaryBrush}" Padding="10,6" CornerRadius="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="220" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="恢复后原始完整文件名" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="1" Text="NAS 物理存储别名" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="2" Text="文件大小" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="3" Text="SHA-256 完整性哈希" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>

                <!-- Files ListView -->
                <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.PackageFiles, Mode=OneWay}" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="6,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="220" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding OriginalRelPath}" ToolTipService.ToolTip="{Binding OriginalRelPath}" FontSize="12" TextTrimming="CharacterEllipsis" FontWeight="Medium" />
                                <TextBlock Grid.Column="1" Text="{Binding StoredRelPath}" ToolTipService.ToolTip="{Binding StoredRelPath}" FontSize="11" FontFamily="Consolas" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" Text="{Binding FormattedSize}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="3" Text="{Binding Sha256}" ToolTipService.ToolTip="{Binding Sha256}" FontSize="10" FontFamily="Consolas" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
              </PivotItem>
              <PivotItem Header="历史版本">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ListView ItemsSource="{x:Bind ViewModel.HistoryFilesList, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedHistory, Mode=TwoWay}"
                              IsEnabled="{x:Bind ViewModel.CanConfigureRestore, Mode=OneWay}"
                              SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Padding="6,4" Spacing="2">
                                    <TextBlock Text="{Binding OriginalRel}" ToolTipService.ToolTip="{Binding OriginalRel}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <TextBlock Text="{Binding ArchivedAt}" FontSize="11" />
                                        <TextBlock Text="{Binding Reason}" FontSize="11" />
                                        <TextBlock Text="{Binding Size}" FontSize="11" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Button Content="恢复所选历史版本" Command="{x:Bind ViewModel.RestoreHistoryCommand}"
                                IsEnabled="{x:Bind ViewModel.CanConfigureRestore, Mode=OneWay}" />
                        <TextBlock Text="使用下方的目标路径和冲突处理方式" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
              </PivotItem>
            </Pivot>
        </Border>

        <!-- 4. RESTORE EXECUTION PANEL -->
        <Border Grid.Row="3" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="180" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="还原到本地路径:" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBox Grid.Column="1" Text="{x:Bind ViewModel.LocalRestoreTarget, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.CanConfigureRestore, Mode=OneWay}" FontSize="12" FontFamily="Consolas, Segoe UI" VerticalAlignment="Center" />
                    <Button Grid.Column="2" Click="BtnBrowseLocalRestore_Click" IsEnabled="{x:Bind ViewModel.CanConfigureRestore, Mode=OneWay}" Margin="8,0,14,0">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE8B7;" FontSize="11" />
                            <TextBlock Text="浏览..." FontSize="12" />
                        </StackPanel>
                    </Button>

                    <ComboBox Grid.Column="3" SelectedIndex="{x:Bind ViewModel.ConflictPolicyIndex, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.CanConfigureRestore, Mode=OneWay}" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="跳过已存在文件" />
                        <ComboBoxItem Content="覆盖已存在文件" />
                        <ComboBoxItem Content="自动加时间戳重命名" />
                    </ComboBox>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="4">
                        <Grid>
                            <TextBlock Text="{x:Bind ViewModel.RestoreStatusText, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind ViewModel.DetailedErrorMessage, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                        </Grid>
                        <ProgressBar Value="{x:Bind ViewModel.RestoreProgress, Mode=OneWay}" Maximum="100" Height="4" />
                        
                        <!-- 统计与指标卡 -->
                        <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,4,0,0">
                            <TextBlock FontSize="11" Foreground="{ThemeResource SystemFillColorSuccessBrush}">
                                <Run Text="已恢复: " /><Run Text="{x:Bind ViewModel.RestoredFilesCount, Mode=OneWay}" FontWeight="SemiBold" />
                            </TextBlock>
                            <TextBlock FontSize="11" Foreground="{ThemeResource SystemFillColorSuccessBrush}">
                                <Run Text="校验通过: " /><Run Text="{x:Bind ViewModel.IntegrityVerifiedCount, Mode=OneWay}" FontWeight="SemiBold" />
                            </TextBlock>
                            <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}">
                                <Run Text="已跳过: " /><Run Text="{x:Bind ViewModel.SkippedFilesCount, Mode=OneWay}" FontWeight="SemiBold" />
                            </TextBlock>
                            <TextBlock FontSize="11" Foreground="{ThemeResource SystemFillColorCriticalBrush}">
                                <Run Text="失败: " /><Run Text="{x:Bind ViewModel.FailedFilesCount, Mode=OneWay}" FontWeight="SemiBold" />
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="16,0,0,0" VerticalAlignment="Center">
                        <Button Command="{x:Bind ViewModel.ExportRestoreLogCommand}" ToolTipService.ToolTip="导出完整还原与校验日志">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xEDE1;" FontSize="12" />
                                <TextBlock Text="导出报告" FontSize="12" />
                            </StackPanel>
                        </Button>
                        <Button Command="{x:Bind ViewModel.RetryFailedFilesCommand}" Style="{ThemeResource AccentButtonStyle}" Background="#DC2626">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE72C;" FontSize="12" />
                                <TextBlock Text="重试失败" FontSize="12" />
                            </StackPanel>
                        </Button>
                        <Button Command="{x:Bind ViewModel.ExecuteRestoreCommand}" Style="{ThemeResource AccentButtonStyle}" Padding="16,8">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE896;" FontSize="14" />
                                <TextBlock Text="开始完整还原 (SHA-256 强校验)" FontSize="12" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
