<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FNSyncPlus.WinUI.Pages.AddFolderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:FNSyncPlus.WinUI.ViewModels"
    mc:Ignorable="d">

    <Grid Padding="24,12,24,20" RowSpacing="14">
        <Grid.RowDefinitions>
            <!-- 0: TOP BAR WITH BACK BUTTON & STEP PILLS -->
            <RowDefinition Height="Auto" />
            <!-- 1: RESPONSIVE CONTENT AREA (SCROLLABLE IF NEEDED) -->
            <RowDefinition Height="*" />
            <!-- 2: PINNED BOTTOM ACTION CONTROLS (ALWAYS VISIBLE) -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 0. TOP NAVIGATION & STEP PROGRESS -->
        <Border Grid.Row="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Back button & Page Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button Click="BtnBackToTasks_Click" Style="{ThemeResource SubtleButtonStyle}" Padding="8,4" ToolTipService.ToolTip="返回任务列表">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72B;" FontSize="12" />
                            <TextBlock Text="返回任务" FontSize="12" />
                        </StackPanel>
                    </Button>
                    <Border Width="1" Height="16" Background="{ThemeResource DividerStrokeColorDefaultBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="添加自动备份文件夹" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Step Indicator Pills -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Background="{x:Bind GetStepPillBg(ViewModel.CurrentStep, 1), Mode=OneWay}" CornerRadius="4" Padding="10,4">
                        <TextBlock Text="1. 本地源目录" FontSize="11" Foreground="{x:Bind GetStepPillFg(ViewModel.CurrentStep, 1), Mode=OneWay}" FontWeight="Medium" />
                    </Border>
                    <FontIcon Glyph="&#xE76C;" FontSize="9" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                    <Border Background="{x:Bind GetStepPillBg(ViewModel.CurrentStep, 2), Mode=OneWay}" CornerRadius="4" Padding="10,4">
                        <TextBlock Text="2. NAS 目标位置" FontSize="11" Foreground="{x:Bind GetStepPillFg(ViewModel.CurrentStep, 2), Mode=OneWay}" FontWeight="Medium" />
                    </Border>
                    <FontIcon Glyph="&#xE76C;" FontSize="9" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                    <Border Background="{x:Bind GetStepPillBg(ViewModel.CurrentStep, 3), Mode=OneWay}" CornerRadius="4" Padding="10,4">
                        <TextBlock Text="3. 自动规划与确认" FontSize="11" Foreground="{x:Bind GetStepPillFg(ViewModel.CurrentStep, 3), Mode=OneWay}" FontWeight="Medium" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 1. MIDDLE RESPONSIVE CONTENT AREA -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid MinHeight="420">
                <!-- STEP 1: LOCAL SOURCE FOLDERS -->
                <Border Visibility="{x:Bind ViewModel.IsStep1, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                    <Grid RowSpacing="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Header & Add Button -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="选择需要自动同步备份的本地文件夹" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="支持添加单个或批量添加多个不同盘符的文件夹。每个文件夹在 NAS 端将独立规划隔离目录，互不干扰。" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1" Click="BtnAddLocalFolder_Click" Style="{ThemeResource AccentButtonStyle}" Padding="16,8">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8F4;" FontSize="13" />
                                    <TextBlock Text="添加本地文件夹..." FontSize="12" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Folders List or Empty State -->
                        <Grid Grid.Row="1" MinHeight="220">
                            <!-- Empty State Card -->
                            <StackPanel Visibility="{x:Bind GetEmptyStateVisibility(ViewModel.SelectedLocalFolders.Count), Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                                <FontIcon Glyph="&#xE8B7;" FontSize="40" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="尚未选择任何待备份文件夹" FontSize="14" FontWeight="Medium" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="点击右上角【添加本地文件夹...】按钮选择需要保护的电脑文件夹。未添加文件夹前无法进入下一步。" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                            </StackPanel>

                            <!-- Selected Folders List -->
                            <ListView Visibility="{x:Bind GetListStateVisibility(ViewModel.SelectedLocalFolders.Count), Mode=OneWay}" ItemsSource="{x:Bind ViewModel.SelectedLocalFolders, Mode=OneWay}" SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="12,8" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Grid.Column="0" Glyph="&#xE8B7;" FontSize="16" Margin="0,0,12,0" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding}" FontSize="13" FontFamily="Consolas, Segoe UI" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <Button Grid.Column="2" Click="BtnRemoveFolder_Click" Tag="{Binding}" Style="{ThemeResource SubtleButtonStyle}" Padding="8,4" ToolTipService.ToolTip="移除此文件夹">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <FontIcon Glyph="&#xE74D;" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                                    <TextBlock Text="移除" FontSize="11" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>

                        <!-- Step 1 Notice -->
                        <InfoBar Grid.Row="2" IsOpen="True" Severity="{x:Bind GetStep1NoticeSeverity(ViewModel.SelectedLocalFolders.Count), Mode=OneWay}" Title="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Message="系统将严格遵循沙箱隔离机制，对每个选中的源文件夹独立计算 UTF-8 字节并无损处理超长文件名。" IsClosable="False" />
                    </Grid>
                </Border>

                <!-- STEP 2: DUAL-PANE NAS BROWSER -->
                <Grid Visibility="{x:Bind ViewModel.IsStep2, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Dual-Pane Explorer -->
                    <Grid Grid.Row="0" ColumnSpacing="12" MinHeight="360">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Categories (Personal Space Prioritized) -->
                        <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                            <Grid RowSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="NAS 存储空间分类" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="4,2" />
                                <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.NasBrowser.Categories, Mode=OneWay}" SelectionMode="Single" SelectionChanged="CategoryList_SelectionChanged">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Padding="8,8" ColumnSpacing="10" CornerRadius="4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon Grid.Column="0" Glyph="{Binding IconGlyph}" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Border>

                        <!-- Right: Subfolders, Breadcrumbs, Search, New Folder -->
                        <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                            <Grid RowSpacing="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Top Toolbar -->
                                <Grid Grid.Row="0" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Breadcrumbs -->
                                    <BreadcrumbBar Grid.Column="0" ItemsSource="{x:Bind ViewModel.NasBrowser.BreadcrumbItems, Mode=OneWay}" ItemClicked="BreadcrumbBar_ItemClicked" VerticalAlignment="Center">
                                        <BreadcrumbBar.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Label}" FontSize="12" FontFamily="Consolas, Segoe UI" />
                                            </DataTemplate>
                                        </BreadcrumbBar.ItemTemplate>
                                    </BreadcrumbBar>

                                    <!-- Search Box -->
                                    <AutoSuggestBox Grid.Column="1" Text="{x:Bind ViewModel.NasBrowser.SearchText, Mode=TwoWay}" PlaceholderText="搜索子文件夹..." QueryIcon="Find" FontSize="12" VerticalAlignment="Center" />

                                    <!-- Inline New Folder Button -->
                                    <Button Grid.Column="2" Padding="10,6" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE8F4;" FontSize="12" />
                                            <TextBlock Text="新建子文件夹" FontSize="12" />
                                        </StackPanel>
                                        <Button.Flyout>
                                            <Flyout x:Name="InlineNewFolderFlyout">
                                                <StackPanel Spacing="10" Width="240">
                                                    <TextBlock Text="在当前目录新建文件夹" FontWeight="SemiBold" FontSize="13" />
                                                    <TextBox x:Name="TxtInlineNewFolderName" PlaceholderText="输入文件夹名称" FontSize="12" />
                                                    <Button Click="BtnInlineCreateFolder_Click" Style="{ThemeResource AccentButtonStyle}" HorizontalAlignment="Stretch">
                                                        <TextBlock Text="确认创建" FontSize="12" />
                                                    </Button>
                                                </StackPanel>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                </Grid>

                                <!-- Subfolder Content Area -->
                                <Grid Grid.Row="1">
                                    <!-- Empty Folder Notice -->
                                    <StackPanel Visibility="{x:Bind GetEmptyNoticeVisibility(ViewModel.NasBrowser.FolderItems.Count), Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                                        <FontIcon Glyph="&#xE8B7;" FontSize="32" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="此目录为空 (暂无子文件夹)" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="可在上方点击【新建子文件夹】创建新分类，或直接选择当前目录作为备份根目录。" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                                    </StackPanel>

                                    <!-- Subfolder List -->
                                    <ListView
                                        Visibility="{x:Bind GetListStateVisibility(ViewModel.NasBrowser.FolderItems.Count), Mode=OneWay}"
                                        ItemsSource="{x:Bind ViewModel.NasBrowser.FolderItems, Mode=OneWay}"
                                        SelectedItem="{x:Bind ViewModel.NasBrowser.SelectedFolder, Mode=TwoWay}"
                                        SelectionMode="Single"
                                        DoubleTapped="FolderList_DoubleTapped">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Padding="8,7" ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <FontIcon Grid.Column="0" Glyph="&#xE8B7;" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="2" Text="{Binding RelativeSubPath}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" FontFamily="Consolas" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Step 2 Bottom Info & Status -->
                    <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14,8">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="{x:Bind ViewModel.NasBrowser.CurrentUncPath, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" FontFamily="Consolas" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind ViewModel.NasBrowser.SecurityDescription, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="8,3">
                                    <TextBlock Text="{x:Bind ViewModel.NasBrowser.PermissionStatusText, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource SystemFillColorSuccessBrush}" FontWeight="Medium" />
                                </Border>
                                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="8,3">
                                    <TextBlock Text="{x:Bind ViewModel.NasBrowser.SecurityTitle, Mode=OneWay}" FontSize="11" FontWeight="Medium" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- STEP 3: AUTO-PLAN PREVIEW & CONFIRMATION -->
                <Border Visibility="{x:Bind ViewModel.IsStep3, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                    <Grid RowSpacing="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Spacing="4">
                            <TextBlock Text="自动规划备份方案预览（同名文件夹自动创建与防覆盖去重）" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="系统已为每个本地源文件夹在 NAS 端规划好对应的独立子目录。如遇重名已自动进行冲突编号隔离。" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.PlannedTasks, Mode=OneWay}" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="12,8" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="160" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding SourcePath}" FontSize="12" FontFamily="Consolas" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding FullTargetUnc}" FontSize="12" FontFamily="Consolas" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding StatusText}" FontSize="12" Foreground="{ThemeResource SystemFillColorSuccessBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <InfoBar Grid.Row="2" IsOpen="True" Severity="{x:Bind GetSecuritySeverity(ViewModel.IsTeamShareWarning), Mode=OneWay}" Title="{x:Bind ViewModel.SecurityTitle, Mode=OneWay}" Message="{x:Bind ViewModel.SecurityDescription, Mode=OneWay}" IsClosable="False" />
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- 2. PINNED BOTTOM ACTION CONTROLS (ALWAYS VISIBLE) -->
        <Border Grid.Row="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Cancel Button (One single Cancel button) -->
                <Button Grid.Column="0" Click="BtnBackToTasks_Click" Content="取消返回" Padding="16,8" />

                <!-- Right: Wizard Navigation Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12">
                    <Button Click="BtnPreviousStep_Click" Visibility="{x:Bind ViewModel.CanGoBack, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" Padding="16,8">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72B;" FontSize="11" />
                            <TextBlock Text="上一步" FontSize="12" />
                        </StackPanel>
                    </Button>

                    <Button Click="BtnNextStep_Click" Visibility="{x:Bind ViewModel.IsStep3, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" IsEnabled="{x:Bind ViewModel.CanGoNext, Mode=OneWay}" Style="{ThemeResource AccentButtonStyle}" Padding="20,8">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="下一步" FontSize="12" FontWeight="SemiBold" />
                            <FontIcon Glyph="&#xE72A;" FontSize="11" />
                        </StackPanel>
                    </Button>

                    <Button Click="BtnCreateAndStart_Click" Visibility="{x:Bind ViewModel.IsStep3, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" IsEnabled="{x:Bind ViewModel.CanCreate, Mode=OneWay}" Style="{ThemeResource AccentButtonStyle}" Padding="22,8">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE896;" FontSize="13" />
                            <TextBlock Text="确认创建并开始备份" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
