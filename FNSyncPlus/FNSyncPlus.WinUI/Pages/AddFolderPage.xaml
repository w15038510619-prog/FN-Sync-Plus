<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FNSyncPlus.WinUI.Pages.AddFolderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:FNSyncPlus.WinUI.ViewModels"
    xmlns:controls="using:FNSyncPlus.WinUI.Controls"
    mc:Ignorable="d">

    <Grid Padding="{StaticResource PageContentPadding}" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 0. TOP BAR WITH BACK LINK & STEP PILLS -->
        <Border Grid.Row="0" Style="{StaticResource SurfaceCardStyle}" Padding="14,10">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button Click="BtnBackToTasks_Click" Style="{StaticResource SubtleIconButtonStyle}" Padding="8,5" ToolTipService.ToolTip="返回同步任务列表">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72B;" FontSize="12" />
                            <TextBlock Text="返回任务" FontSize="12" />
                        </StackPanel>
                    </Button>
                    <Border Width="1" Height="16" Background="{ThemeResource DividerStrokeColorDefaultBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="添加自动备份文件夹" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Step Indicator Pills -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <controls:StatusBadge Text="1. 选择本地文件夹"
                                          Tone="{x:Bind GetStepPillTone(ViewModel.CurrentStep, 1), Mode=OneWay}"
                                          ShowDot="False" VerticalAlignment="Center" />
                    <FontIcon Glyph="&#xE76C;" FontSize="9" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                    <controls:StatusBadge Text="2. 确认备份位置"
                                          Tone="{x:Bind GetStepPillTone(ViewModel.CurrentStep, 2), Mode=OneWay}"
                                          ShowDot="False" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 1. MIDDLE CONTENT AREA -->
        <Grid Grid.Row="1" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- NAS Disconnected Warning Banner -->
            <InfoBar Grid.Row="0"
                     IsOpen="{x:Bind ViewModel.IsNasDisconnectedWarning, Mode=OneWay}"
                     Severity="Error"
                     Title="NAS 连接已断开，请重新连接"
                     Message="已保留你选择的本地文件夹草稿。重连飞牛 NAS 后即可继续完成备份任务创建。"
                     IsClosable="False">
                <InfoBar.ActionButton>
                    <Button Click="BtnReconnectNas_Click" Style="{StaticResource PrimaryActionButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <FontIcon Glyph="&#xE72C;" FontSize="11" />
                            <TextBlock Text="前往连接" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </InfoBar.ActionButton>
            </InfoBar>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                <Grid MinHeight="380">
                    <!-- STEP 1: SELECT LOCAL FOLDERS -->
                    <Border Visibility="{x:Bind ViewModel.IsStep1, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                            Style="{StaticResource SurfaceCardStyle}" Padding="20">
                        <Grid RowSpacing="16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Header -->
                            <Grid Grid.Row="0" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="3">
                                    <TextBlock Text="选择要自动备份的电脑文件夹" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="可一次添加一个或多个不同磁盘的文件夹，系统会为每个文件夹独立建立备份目录。" Style="{StaticResource CardSubtitleTextStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="1" Click="BtnAddLocalFolder_Click" Style="{StaticResource PrimaryActionButtonStyle}" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE8F4;" FontSize="13" />
                                        <TextBlock Text="选择本地文件夹…" FontSize="12" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Folders List or Empty State -->
                            <Grid Grid.Row="1" MinHeight="220">
                                <!-- Empty State -->
                                <Border Visibility="{x:Bind GetEmptyStateVisibility(ViewModel.SelectedLocalFolders.Count), Mode=OneWay}"
                                        Style="{StaticResource InsetSurfaceStyle}" Padding="24">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" MaxWidth="420">
                                        <Border Width="52" Height="52" CornerRadius="26" Background="{ThemeResource SoftAccentBackgroundBrush}" HorizontalAlignment="Center">
                                            <FontIcon Glyph="&#xE8B7;" FontSize="24" Foreground="{ThemeResource FolderIconBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="尚未选择需要保护的本地文件夹" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="点击下方按钮挑选电脑里的文档、照片或项目目录，添加后将自动规划对应的 NAS 备份目录。"
                                                   Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" TextAlignment="Center" />
                                        <Button Click="BtnAddLocalFolder_Click" Style="{StaticResource PrimaryActionButtonStyle}" HorizontalAlignment="Center" Margin="0,4,0,0">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE8F4;" FontSize="13" />
                                                <TextBlock Text="选择本地文件夹…" FontSize="12" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- Selected Folders List -->
                                <ListView Visibility="{x:Bind GetListStateVisibility(ViewModel.SelectedLocalFolders.Count), Mode=OneWay}"
                                          ItemsSource="{x:Bind ViewModel.SelectedLocalFolders, Mode=OneWay}"
                                          SelectionMode="None">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Padding" Value="0,3" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource InsetSurfaceStyle}" Padding="14,10">
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <FontIcon Grid.Column="0" Glyph="&#xE8B7;" FontSize="17" Foreground="{ThemeResource FolderIconBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding}" Style="{StaticResource MonoPathTextStyle}" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding}" />
                                                    <Button Grid.Column="2" Click="BtnRemoveFolder_Click" Tag="{Binding}" Style="{StaticResource SubtleIconButtonStyle}" Padding="8,4" ToolTipService.ToolTip="移出本次列表">
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <FontIcon Glyph="&#xE74D;" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                                            <TextBlock Text="移除" FontSize="11" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>

                            <!-- Step 1 Conflict Warning + Subtle Tip -->
                            <StackPanel Grid.Row="2" Spacing="8">
                                <InfoBar IsOpen="{x:Bind ViewModel.HasDuplicateConflict, Mode=OneWay}"
                                         Severity="Warning"
                                         Title="该文件夹已存在备份任务"
                                         Message="{x:Bind ViewModel.DuplicateWarningMessage, Mode=OneWay}"
                                         IsClosable="False">
                                    <InfoBar.ActionButton>
                                        <Button Click="BtnViewExistingTasks_Click" Style="{StaticResource CompactSecondaryButtonStyle}">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon Glyph="&#xE8FD;" FontSize="12" />
                                                <TextBlock Text="查看已有任务" FontSize="12" />
                                            </StackPanel>
                                        </Button>
                                    </InfoBar.ActionButton>
                                </InfoBar>

                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE946;" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- STEP 2: CONFIRM NAS BACKUP LOCATION & PREVIEW -->
                    <Border Visibility="{x:Bind ViewModel.IsStep2, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                            Style="{StaticResource SurfaceCardStyle}" Padding="20">
                        <Grid RowSpacing="14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Header -->
                            <StackPanel Grid.Row="0" Spacing="3">
                                <TextBlock Text="确认 NAS 备份位置" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="已为每个本地文件夹规划独立的同名备份目录，避免覆盖已有数据。如需调整，可点击右侧更改位置。" Style="{StaticResource CardSubtitleTextStyle}" TextWrapping="Wrap" />
                            </StackPanel>

                            <!-- NAS Destination Root Card -->
                            <Border Grid.Row="1" Style="{StaticResource InsetSurfaceStyle}" Padding="16,12">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="6" Background="{ThemeResource SoftAccentBackgroundBrush}" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE753;" FontSize="16" Foreground="{ThemeResource SoftAccentForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="NAS 备份父目录" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                            <controls:StatusBadge Text="{x:Bind ViewModel.StorageSpaceBadgeText, Mode=OneWay}"
                                                                  Tone="{x:Bind ViewModel.StorageSpaceBadgeTone, Mode=OneWay}"
                                                                  VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind ViewModel.NasDestinationRoot, Mode=OneWay}"
                                                   FontSize="14" FontWeight="SemiBold" FontFamily="Consolas, Segoe UI Variable Text"
                                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTipService.ToolTip="{x:Bind ViewModel.NasDestinationRoot, Mode=OneWay}" />
                                    </StackPanel>

                                    <Button Grid.Column="2" Click="BtnChangeParentFolder_Click" Style="{StaticResource SecondaryActionButtonStyle}" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE8B7;" FontSize="12" />
                                            <TextBlock Text="更改位置…" FontSize="12" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Planned Folder Mappings (Clean Card Rows, No Horizontal Scrollbar) -->
                            <Grid Grid.Row="2" RowSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="备份映射预览" Style="{StaticResource SectionHeaderTextStyle}" />

                                <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.PlannedTasks, Mode=OneWay}" SelectionMode="None" MinHeight="140">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Padding" Value="0,3" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="vm:PlannedTaskItem">
                                            <Border Style="{StaticResource InsetSurfaceStyle}" Padding="14,10">
                                                <Grid ColumnSpacing="12" RowSpacing="4">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Source folder name + StatusBadge -->
                                                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                        <FontIcon Glyph="&#xE8B7;" FontSize="15" Foreground="{ThemeResource FolderIconBrush}" VerticalAlignment="Center" />
                                                        <TextBlock Text="{x:Bind SourceFolderName}" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>

                                                    <controls:StatusBadge Grid.Row="0" Grid.Column="1"
                                                                          Text="{x:Bind CleanStatusText, Mode=OneWay}"
                                                                          Tone="{x:Bind StatusTone, Mode=OneWay}"
                                                                          VerticalAlignment="Center" />

                                                    <!-- Mapping line: Local -> NAS -->
                                                    <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{x:Bind SourcePath}" Style="{StaticResource MonoPathTextStyle}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind SourcePath}" />
                                                        <FontIcon Grid.Column="1" Glyph="&#xE72A;" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="2" Text="{x:Bind FullTargetUnc}" Style="{StaticResource MonoPathTextStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind FullTargetUnc}" />
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>

                            <!-- Optional Reuse Existing Folder Expander -->
                            <Expander Grid.Row="3"
                                      Visibility="{x:Bind ViewModel.ShowExperimentalReuse, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                      Header="{x:Bind ViewModel.ReuseHeading, Mode=OneWay}"
                                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="14,10">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="内容一致的文件将在 NAS 内直接复用；缺失或变动文件从电脑上传。原目录保持不变，新备份目录必须与已有目录分开。"
                                               Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                    <TextBlock Text="每次备份变更会保留历史版本，空间占用将随历史增长且当前不会自动清理，请确认 NAS 空间充足。"
                                               Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{x:Bind ViewModel.ExperimentalExistingRoot, Mode=OneWay}" IsReadOnly="True" PlaceholderText="未选择已有目录（将正常上传）" />
                                        <Button Grid.Column="1" Click="BtnSelectExistingFolder_Click" Content="选择已有目录" Style="{StaticResource SecondaryActionButtonStyle}" />
                                        <Button Grid.Column="2" Click="BtnClearExistingFolder_Click" Content="清除" Style="{StaticResource SecondaryActionButtonStyle}" />
                                    </Grid>
                                </StackPanel>
                            </Expander>

                            <!-- Security InfoBar -->
                            <InfoBar Grid.Row="4" IsOpen="True"
                                     Severity="{x:Bind GetSecuritySeverity(ViewModel.IsTeamShareWarning), Mode=OneWay}"
                                     Title="{x:Bind ViewModel.SecurityTitle, Mode=OneWay}"
                                     Message="{x:Bind ViewModel.SecurityDescription, Mode=OneWay}"
                                     IsClosable="False" />
                        </Grid>
                    </Border>

                    <!-- STEP 3: CREATION RESULT FEEDBACK -->
                    <Border Visibility="{x:Bind ViewModel.IsCreationComplete, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                            Style="{StaticResource SurfaceCardStyle}" Padding="28">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" MaxWidth="560">
                            <Border Width="56" Height="56" CornerRadius="28"
                                    Background="{ThemeResource StatusSuccessBackgroundBrush}"
                                    BorderBrush="{ThemeResource StatusSuccessBorderBrush}"
                                    BorderThickness="1" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE73E;" FontSize="24" Foreground="{ThemeResource StatusSuccessForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <TextBlock Text="{x:Bind ViewModel.CreationResultTitle, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.CreationResultDetail, Mode=OneWay}" Style="{StaticResource CardSubtitleTextStyle}" TextWrapping="Wrap" TextAlignment="Center" />

                            <Border Style="{StaticResource InsetSurfaceStyle}" Padding="14,10" HorizontalAlignment="Stretch">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.CreatedTaskSummaries, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Style="{StaticResource MonoPathTextStyle}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Margin="0,3" TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>

                            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" Margin="0,6,0,0">
                                <Button Click="BtnBackToTasks_Click" Style="{StaticResource PrimaryActionButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE8FD;" FontSize="13" />
                                        <TextBlock Text="返回同步任务查看进度" FontSize="13" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                                <Button Click="BtnContinueAddMore_Click" Style="{StaticResource SecondaryActionButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE710;" FontSize="12" />
                                        <TextBlock Text="继续添加文件夹" FontSize="12" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- 2. PINNED BOTTOM ACTION BAR (Hidden when showing Creation Complete screen) -->
        <Border Grid.Row="2"
                Visibility="{x:Bind ViewModel.IsCreationComplete, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                Style="{StaticResource SurfaceCardStyle}" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Click="BtnBackToTasks_Click" Content="取消返回" Style="{StaticResource SecondaryActionButtonStyle}" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
                    <Button Click="BtnPreviousStep_Click"
                            Visibility="{x:Bind ViewModel.CanGoBack, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                            Style="{StaticResource SecondaryActionButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72B;" FontSize="11" />
                            <TextBlock Text="上一步" FontSize="12" />
                        </StackPanel>
                    </Button>

                    <Button Click="BtnNextStep_Click"
                            Visibility="{x:Bind ViewModel.IsStep1, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                            IsEnabled="{x:Bind ViewModel.CanGoNext, Mode=OneWay}"
                            Style="{StaticResource PrimaryActionButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="下一步：确认备份位置" FontSize="12" FontWeight="SemiBold" />
                            <FontIcon Glyph="&#xE72A;" FontSize="11" />
                        </StackPanel>
                    </Button>

                    <Button Click="BtnCreateAndStart_Click"
                            Visibility="{x:Bind ViewModel.IsStep2, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                            IsEnabled="{x:Bind ViewModel.CanCreate, Mode=OneWay}"
                            Style="{StaticResource PrimaryActionButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE896;" FontSize="13" />
                            <TextBlock Text="确认创建并开始备份" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
