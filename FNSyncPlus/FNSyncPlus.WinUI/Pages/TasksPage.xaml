<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FNSyncPlus.WinUI.Pages.TasksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:FNSyncPlus.WinUI.Controls"
    xmlns:vm="using:FNSyncPlus.WinUI.ViewModels"
    mc:Ignorable="d">

    <Grid Padding="{StaticResource PageContentPadding}" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 1. TOP HEADER & PRIMARY COMMANDS -->
        <Grid Grid.Row="0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="0" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="同步任务" Style="{StaticResource PageTitleTextStyle}" />
                    <controls:StatusBadge
                        Text="{x:Bind ViewModel.TotalTasksCountText, Mode=OneWay}"
                        Tone="{x:Bind ViewModel.HeaderSummaryTone, Mode=OneWay}"
                        ShowDot="False"
                        MaxTextWidth="220" />
                </StackPanel>
                <TextBlock
                    Text="按文件夹独立监控与增量备份，支持超长中文名与历史版本保护"
                    Style="{StaticResource PageSubtitleTextStyle}" />
                <TextBlock
                    x:Name="BetaSafetyNotice"
                    Visibility="Collapsed"
                    Text="新版备份仍在试用；请勿让其他设备或程序同时写入同一备份目录。"
                    Style="{StaticResource CardSubtitleTextStyle}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Click="BtnAddFolder_Click" Style="{StaticResource PrimaryActionButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE710;" FontSize="12" />
                        <TextBlock Text="添加文件夹" />
                    </StackPanel>
                </Button>
                <Button
                    Click="BtnSyncAll_Click"
                    Style="{StaticResource SecondaryActionButtonStyle}"
                    IsEnabled="{x:Bind ViewModel.HasTasks, Mode=OneWay}"
                    ToolTipService.ToolTip="立即运行所有未暂停的备份任务">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE895;" FontSize="12" />
                        <TextBlock Text="全部立即备份" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 2. MAIN CONTENT: EMPTY STATE OR COMPACT TASK CARDS -->
        <Grid Grid.Row="1">
            <!-- Empty State -->
            <Border
                Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                Style="{StaticResource SurfaceCardStyle}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="460"
                Padding="36,32">
                <StackPanel Spacing="14" HorizontalAlignment="Center">
                    <Border
                        Width="56"
                        Height="56"
                        Background="{ThemeResource SoftAccentBackgroundBrush}"
                        CornerRadius="28"
                        HorizontalAlignment="Center">
                        <FontIcon
                            Glyph="&#xE8B7;"
                            FontSize="26"
                            Foreground="{ThemeResource SoftAccentForegroundBrush}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>
                    <TextBlock
                        Text="还没有同步任务"
                        FontSize="17"
                        FontWeight="SemiBold"
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    <TextBlock
                        Text="添加一个本地文件夹，FN Sync Plus 将自动备份至飞牛 NAS，并保留版本历史以备随时还原。"
                        Style="{StaticResource PageSubtitleTextStyle}"
                        TextAlignment="Center" />
                    <Button
                        Click="BtnAddFolder_Click"
                        Style="{StaticResource PrimaryActionButtonStyle}"
                        HorizontalAlignment="Center"
                        Margin="0,4,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE710;" FontSize="12" />
                            <TextBlock Text="添加第一个文件夹" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Active Task Cards -->
            <ListView
                x:Name="ListTasks"
                Visibility="{x:Bind ViewModel.HasTasks, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                ItemsSource="{x:Bind ViewModel.Tasks, Mode=OneWay}"
                ItemContainerStyle="{StaticResource TaskCardListViewItemStyle}"
                SelectionMode="None">

                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:SyncTaskItemViewModel">
                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16,13">
                            <Grid RowSpacing="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Row 0: Folder Icon + Name/Status/Meta + Intuitive Actions -->
                                <Grid Grid.Row="0" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" MinWidth="0" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border
                                        Grid.Column="0"
                                        Width="36"
                                        Height="36"
                                        Background="{ThemeResource SoftAccentBackgroundBrush}"
                                        CornerRadius="8"
                                        VerticalAlignment="Center">
                                        <FontIcon
                                            Glyph="&#xE8B7;"
                                            FontSize="17"
                                            Foreground="{ThemeResource FolderIconBrush}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3" MinWidth="0">
                                        <Grid ColumnSpacing="8" MinWidth="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" MinWidth="0" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Grid.Column="0"
                                                Text="{x:Bind TaskName, Mode=OneWay}"
                                                FontWeight="SemiBold"
                                                FontSize="14"
                                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                TextTrimming="CharacterEllipsis"
                                                VerticalAlignment="Center"
                                                ToolTipService.ToolTip="{x:Bind TaskName, Mode=OneWay}" />
                                            <controls:StatusBadge
                                                Grid.Column="1"
                                                Text="{x:Bind DisplayStatus, Mode=OneWay}"
                                                Tone="{x:Bind StatusTone, Mode=OneWay}"
                                                MaxTextWidth="168" />
                                        </Grid>

                                        <TextBlock
                                            Text="{x:Bind CompactMetaLine, Mode=OneWay}"
                                            ToolTipService.ToolTip="{x:Bind FormattedLastSync, Mode=OneWay}"
                                            Style="{StaticResource CaptionTextStyle}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <!-- Intuitive Action Cluster: 立即备份 | 暂停 / 继续自动备份 | 详情 | 更多 -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <!-- Continue Auto Backup (Paused state — clearly distinct from Restore Files) -->
                                        <Button
                                            Command="{x:Bind TogglePauseCommand}"
                                            Visibility="{x:Bind IsPaused, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                            Style="{StaticResource CompactSecondaryButtonStyle}"
                                            ToolTipService.ToolTip="继续此任务的自动监控与定时备份">
                                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE768;" FontSize="11" Foreground="{ThemeResource StatusSuccessForegroundBrush}" />
                                                <TextBlock Text="继续自动备份" />
                                            </StackPanel>
                                        </Button>

                                        <!-- Run Now (Idle/Completed/Error active state) -->
                                        <Button
                                            Command="{x:Bind RunSyncCommand}"
                                            IsEnabled="{x:Bind CanRunSync, Mode=OneWay}"
                                            Visibility="{x:Bind ShowRunNowButton, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                            Style="{StaticResource CompactSecondaryButtonStyle}"
                                            ToolTipService.ToolTip="立即执行一次增量备份">
                                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE768;" FontSize="11" Foreground="{ThemeResource SoftAccentForegroundBrush}" />
                                                <TextBlock Text="立即备份" />
                                            </StackPanel>
                                        </Button>

                                        <!-- Pause Auto Backup (Visible whenever task is not paused) -->
                                        <Button
                                            Command="{x:Bind TogglePauseCommand}"
                                            Visibility="{x:Bind CanPauseTask, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                            Style="{StaticResource SubtleIconButtonStyle}"
                                            ToolTipService.ToolTip="暂停自动备份（随时可继续）">
                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE769;" FontSize="11" />
                                                <TextBlock Text="暂停" />
                                            </StackPanel>
                                        </Button>

                                        <!-- Details -->
                                        <Button
                                            Command="{x:Bind ViewDetailsCommand}"
                                            Style="{StaticResource SubtleIconButtonStyle}"
                                            ToolTipService.ToolTip="查看统计、长文件名映射与同步日志">
                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE946;" FontSize="11" />
                                                <TextBlock Text="详情" />
                                            </StackPanel>
                                        </Button>

                                        <!-- More Options Menu -->
                                        <Button
                                            Style="{StaticResource SubtleIconButtonStyle}"
                                            Padding="7,5"
                                            AutomationProperties.Name="更多任务操作"
                                            ToolTipService.ToolTip="更多操作">
                                            <FontIcon Glyph="&#xE712;" FontSize="12" />
                                            <Button.Flyout>
                                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                    <MenuFlyoutItem Text="编辑备份设置" Command="{x:Bind EditSettingsCommand}">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE713;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem
                                                        Text="检查中断的备份"
                                                        Command="{x:Bind InspectInterruptionCommand}"
                                                        Visibility="{x:Bind CanInspectInterruption, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE9D9;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutSeparator />
                                                    <MenuFlyoutItem Text="仅移除任务配置" Command="{x:Bind DeleteTaskCommand}">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE74D;" Foreground="{ThemeResource StatusErrorForegroundBrush}" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                </MenuFlyout>
                                            </Button.Flyout>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- Row 1: Compact Inset Path Bar (Local → NAS) -->
                                <Border Grid.Row="1" Margin="0,9,0,0" Style="{StaticResource InsetSurfaceStyle}">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="0" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" MinWidth="0" />
                                        </Grid.ColumnDefinitions>

                                        <Grid Grid.Column="0" ColumnSpacing="6" VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" MinWidth="0" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Glyph="&#xE7F4;" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Text="{x:Bind SourceFolder, Mode=OneWay}"
                                                ToolTipService.ToolTip="{x:Bind SourceFolder, Mode=OneWay}"
                                                Style="{StaticResource MonoPathTextStyle}"
                                                VerticalAlignment="Center" />
                                        </Grid>

                                        <FontIcon Grid.Column="1" Glyph="&#xE72A;" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />

                                        <Grid Grid.Column="2" ColumnSpacing="6" VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" MinWidth="0" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Glyph="&#xE753;" FontSize="12" Foreground="{ThemeResource SoftAccentForegroundBrush}" VerticalAlignment="Center" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Text="{x:Bind DestinationFolder, Mode=OneWay}"
                                                ToolTipService.ToolTip="{x:Bind DestinationFolder, Mode=OneWay}"
                                                Style="{StaticResource MonoPathTextStyle}"
                                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                VerticalAlignment="Center" />
                                        </Grid>
                                    </Grid>
                                </Border>

                                <!-- Row 2: Live Progress Area (Visible ONLY during active sync) -->
                                <Border
                                    Grid.Row="2"
                                    Margin="0,9,0,0"
                                    Visibility="{x:Bind IsSyncing, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                    Background="{ThemeResource StatusInfoBackgroundBrush}"
                                    BorderBrush="{ThemeResource StatusInfoBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="12,8">
                                    <Grid RowSpacing="6">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0" ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" MinWidth="0" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Grid.Column="0"
                                                Text="{x:Bind CurrentFileText, Mode=OneWay}"
                                                ToolTipService.ToolTip="{x:Bind CurrentFileText, Mode=OneWay}"
                                                FontSize="12"
                                                TextTrimming="CharacterEllipsis"
                                                Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Text="{x:Bind LiveProgressDetailText, Mode=OneWay}"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Foreground="{ThemeResource StatusInfoForegroundBrush}" />
                                        </Grid>
                                        <ProgressBar
                                            Grid.Row="1"
                                            Value="{x:Bind CurrentProgress, Mode=OneWay}"
                                            IsIndeterminate="{x:Bind IsProgressIndeterminate, Mode=OneWay}"
                                            Maximum="100"
                                            Height="4" />
                                    </Grid>
                                </Border>

                                <!-- Row 3: Contextual Error / Failure Notice (Visible ONLY when failed) -->
                                <Border
                                    Grid.Row="3"
                                    Margin="0,9,0,0"
                                    Visibility="{x:Bind HasErrorBanner, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                    Background="{ThemeResource StatusErrorBackgroundBrush}"
                                    BorderBrush="{ThemeResource StatusErrorBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10,6">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" MinWidth="0" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Grid.Column="0" Glyph="&#xE7BA;" FontSize="13" Foreground="{ThemeResource StatusErrorForegroundBrush}" VerticalAlignment="Center" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Text="{x:Bind ErrorSummaryText, Mode=OneWay}"
                                            ToolTipService.ToolTip="{x:Bind ErrorSummaryText, Mode=OneWay}"
                                            FontSize="12"
                                            Foreground="{ThemeResource StatusErrorForegroundBrush}"
                                            TextTrimming="CharacterEllipsis"
                                            VerticalAlignment="Center" />
                                        <Button
                                            Grid.Column="2"
                                            Content="查看详情"
                                            Command="{x:Bind ViewDetailsCommand}"
                                            Style="{StaticResource SubtleIconButtonStyle}"
                                            Padding="8,2"
                                            MinHeight="24" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
