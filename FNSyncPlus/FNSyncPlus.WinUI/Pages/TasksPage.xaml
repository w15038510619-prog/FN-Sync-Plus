<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FNSyncPlus.WinUI.Pages.TasksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:FNSyncPlus.WinUI.ViewModels"
    mc:Ignorable="d">

    <Grid Padding="24,12,24,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 1. TOP HEADER & GLOBAL COMMANDS -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Page Title & Metrics Strip -->
            <StackPanel Grid.Column="0" Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="同步任务" FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    <Border Background="{ThemeResource AccentFillColorTertiaryBrush}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.TotalTasksCountText, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    </Border>
                </StackPanel>
                <TextBlock Text="每个文件夹拥有独立监控、独立清单沙箱与长文件名兼容引擎，互不干扰" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="BetaSafetyNotice" Visibility="Collapsed" Text="新版备份仍在试用；请勿让其他设备或程序同时写入同一备份目录。" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Command Buttons -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button x:Name="BtnViewLegacyTasks" Click="BtnViewLegacyTasks_Click" Content="查看旧任务" Visibility="Collapsed" />
                <Button Click="BtnAddFolder_Click" Style="{ThemeResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE710;" FontSize="12" />
                        <TextBlock Text="添加文件夹" FontSize="12" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
                <Button Click="BtnSyncAll_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE768;" FontSize="12" />
                        <TextBlock Text="全部同步" FontSize="12" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 2. MAIN TASK CARDS LIST OR EMPTY STATE -->
        <Grid Grid.Row="1">
            <!-- Empty State View -->
            <Border
                Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="480"
                Padding="32"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <StackPanel Spacing="12" HorizontalAlignment="Center">
                    <Border Width="64" Height="64" Background="{ThemeResource AccentFillColorTertiaryBrush}" CornerRadius="32" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE8B7;" FontSize="32" Foreground="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="暂无同步任务" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="点击下方按钮添加 Windows 本地文件夹，系统将自动在飞牛 NAS 私人空间规划同名子目录，并提供 255 字节超长中文文件名无损兼容。" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" />
                    <Button Click="BtnAddFolder_Click" Style="{ThemeResource AccentButtonStyle}" HorizontalAlignment="Center" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE710;" FontSize="12" />
                            <TextBlock Text="添加文件夹备份向导" FontSize="12" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Active Task Cards ListView -->
            <ListView
                x:Name="ListTasks"
                Visibility="{x:Bind ViewModel.HasTasks, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                ItemsSource="{x:Bind ViewModel.Tasks, Mode=OneWay}"
                SelectionMode="None">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0,0,0,10" />
                        <Setter Property="Margin" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:SyncTaskItemViewModel">
                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16,14">
                            <Grid RowSpacing="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Header: Folder Icon + Task Name + Badge + Actions -->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <Border Width="32" Height="32" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6">
                                            <FontIcon Glyph="&#xE8B7;" FontSize="16" Foreground="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{x:Bind TaskName, Mode=OneWay}" FontWeight="SemiBold" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                                <Border
                                                    Background="{x:Bind StatusBadgeBgHex, Mode=OneWay, Converter={StaticResource HexToBrushConverter}}"
                                                    CornerRadius="10"
                                                    Padding="8,1"
                                                    VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind DisplayStatus, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="{x:Bind StatusBadgeColorHex, Mode=OneWay, Converter={StaticResource HexToBrushConverter}}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind FormattedLastSync, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />
                                            <TextBlock Text="{x:Bind ScheduleSummaryText, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Action Buttons -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <!-- Sync / Pause / Resume Button -->
                                        <Button
                                            Command="{x:Bind TogglePauseCommand}"
                                            Visibility="{x:Bind IsPaused, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                            ToolTipService.ToolTip="恢复自动同步"
                                            Padding="10,5">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon Glyph="&#xE768;" FontSize="11" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                                <TextBlock Text="恢复" FontSize="12" />
                                            </StackPanel>
                                        </Button>
                                        <Button
                                            Command="{x:Bind TogglePauseCommand}"
                                            Visibility="{x:Bind IsSyncing, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                            ToolTipService.ToolTip="暂停当前任务"
                                            Padding="10,5">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon Glyph="&#xE769;" FontSize="11" Foreground="#D97706" />
                                                <TextBlock Text="暂停" FontSize="12" />
                                            </StackPanel>
                                        </Button>
                                        <Button
                                            Command="{x:Bind RunSyncCommand}"
                                            IsEnabled="{x:Bind CanRunSync, Mode=OneWay}"
                                            Visibility="{x:Bind IsPaused, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                            ToolTipService.ToolTip="立即执行增量同步"
                                            Padding="10,5">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon Glyph="&#xE768;" FontSize="11" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                                <TextBlock Text="同步" FontSize="12" />
                                            </StackPanel>
                                        </Button>

                                        <!-- Details Button -->
                                        <Button Command="{x:Bind ViewDetailsCommand}" ToolTipService.ToolTip="查看任务指标与长文件名映射" Padding="10,5">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon Glyph="&#xE946;" FontSize="11" />
                                                <TextBlock Text="详情" FontSize="12" />
                                            </StackPanel>
                                        </Button>

                                        <!-- More Options Menu -->
                                        <Button Padding="6,5">
                                            <FontIcon Glyph="&#xE712;" FontSize="12" />
                                            <Button.Flyout>
                                                <MenuFlyout>
                                                    <MenuFlyoutItem Text="编辑备份设置" Command="{x:Bind EditSettingsCommand}">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE713;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem Text="检查中断的备份" Command="{x:Bind InspectInterruptionCommand}"
                                                        Visibility="{x:Bind CanInspectInterruption, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                    <MenuFlyoutSeparator />
                                                    <MenuFlyoutItem Text="仅移除任务配置" Command="{x:Bind DeleteTaskCommand}">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE74D;" Foreground="Red" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                </MenuFlyout>
                                            </Button.Flyout>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- Paths Row -->
                                <Border Grid.Row="1" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="10,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE7F4;" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            <TextBlock Text="{x:Bind SourceFolder, Mode=OneWay}" FontSize="12" FontFamily="Consolas, Segoe UI" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        </StackPanel>

                                        <FontIcon Grid.Column="1" Glyph="&#xE76C;" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Margin="12,0" VerticalAlignment="Center" />

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE753;" FontSize="12" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                            <TextBlock Text="{x:Bind DestinationFolder, Mode=OneWay}" FontSize="12" FontFamily="Consolas, Segoe UI" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Live Progress Stream (Visible during active sync) -->
                                <Grid Grid.Row="2" Visibility="{x:Bind IsSyncing, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" RowSpacing="4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0">
                                        <TextBlock Text="{x:Bind CurrentFileText, Mode=OneWay}" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind CurrentProgressText, Mode=OneWay}" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Right" />
                                    </Grid>
                                    <ProgressBar Grid.Row="1" Value="{x:Bind CurrentProgress, Mode=OneWay}" Maximum="100" Height="4" />
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
