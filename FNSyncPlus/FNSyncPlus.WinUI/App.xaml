<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="FNSyncPlus.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:FNSyncPlus.WinUI.Helpers"
    xmlns:local="using:FNSyncPlus.WinUI">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Global Converters -->
            <helpers:BoolToColorConverter x:Key="BoolToColorConverter" />
            <helpers:HexToBrushConverter x:Key="HexToBrushConverter" />
            <helpers:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <helpers:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
