<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- =========================================================================
         FN Sync Plus — Unified Windows 11 Fluent Design System
         All pages and dialogs share these tokens, theme brushes, typography
         ramps, surface containers, and button styles.
         ========================================================================= -->

    <ResourceDictionary.ThemeDictionaries>
        <!-- LIGHT THEME SEMANTIC TOKENS -->
        <ResourceDictionary x:Key="Light">
            <!-- Semantic Status: Success -->
            <SolidColorBrush x:Key="StatusSuccessBackgroundBrush" Color="#E6F4EA" />
            <SolidColorBrush x:Key="StatusSuccessForegroundBrush" Color="#0F6B36" />
            <SolidColorBrush x:Key="StatusSuccessBorderBrush" Color="#B7DFC4" />

            <!-- Semantic Status: Info / Syncing / Active -->
            <SolidColorBrush x:Key="StatusInfoBackgroundBrush" Color="#E8F2FC" />
            <SolidColorBrush x:Key="StatusInfoForegroundBrush" Color="#005FB8" />
            <SolidColorBrush x:Key="StatusInfoBorderBrush" Color="#BDD8F4" />

            <!-- Semantic Status: Warning / Paused / Waiting -->
            <SolidColorBrush x:Key="StatusWarningBackgroundBrush" Color="#FFF4CE" />
            <SolidColorBrush x:Key="StatusWarningForegroundBrush" Color="#8A5700" />
            <SolidColorBrush x:Key="StatusWarningBorderBrush" Color="#F0D388" />

            <!-- Semantic Status: Error / Critical -->
            <SolidColorBrush x:Key="StatusErrorBackgroundBrush" Color="#FDE7E9" />
            <SolidColorBrush x:Key="StatusErrorForegroundBrush" Color="#B42318" />
            <SolidColorBrush x:Key="StatusErrorBorderBrush" Color="#F5BFC4" />

            <!-- Semantic Status: Neutral / Idle / Offline -->
            <SolidColorBrush x:Key="StatusNeutralBackgroundBrush" Color="#EEF1F5" />
            <SolidColorBrush x:Key="StatusNeutralForegroundBrush" Color="#475467" />
            <SolidColorBrush x:Key="StatusNeutralBorderBrush" Color="#D6DCE5" />

            <!-- Soft Accent Badge & Folder Icon Tint -->
            <SolidColorBrush x:Key="SoftAccentBackgroundBrush" Color="#EBF3FC" />
            <SolidColorBrush x:Key="SoftAccentForegroundBrush" Color="#005A9E" />
            <SolidColorBrush x:Key="FolderIconBrush" Color="#C98A14" />
            <SolidColorBrush x:Key="PathInsetBackgroundBrush" Color="#F5F7FA" />
            <SolidColorBrush x:Key="BrowserToolbarBackgroundBrush" Color="#FAFBFD" />
            <SolidColorBrush x:Key="KeycapBackgroundBrush" Color="#F3F5F8" />
            <SolidColorBrush x:Key="KeycapBorderBrush" Color="#D0D7DE" />
        </ResourceDictionary>

        <!-- DARK THEME SEMANTIC TOKENS -->
        <ResourceDictionary x:Key="Default">
            <!-- Semantic Status: Success -->
            <SolidColorBrush x:Key="StatusSuccessBackgroundBrush" Color="#193424" />
            <SolidColorBrush x:Key="StatusSuccessForegroundBrush" Color="#6CCB5F" />
            <SolidColorBrush x:Key="StatusSuccessBorderBrush" Color="#28523A" />

            <!-- Semantic Status: Info / Syncing / Active -->
            <SolidColorBrush x:Key="StatusInfoBackgroundBrush" Color="#162D47" />
            <SolidColorBrush x:Key="StatusInfoForegroundBrush" Color="#60CDFF" />
            <SolidColorBrush x:Key="StatusInfoBorderBrush" Color="#244B73" />

            <!-- Semantic Status: Warning / Paused / Waiting -->
            <SolidColorBrush x:Key="StatusWarningBackgroundBrush" Color="#3B2E12" />
            <SolidColorBrush x:Key="StatusWarningForegroundBrush" Color="#FCE100" />
            <SolidColorBrush x:Key="StatusWarningBorderBrush" Color="#5D491D" />

            <!-- Semantic Status: Error / Critical -->
            <SolidColorBrush x:Key="StatusErrorBackgroundBrush" Color="#3E1D21" />
            <SolidColorBrush x:Key="StatusErrorForegroundBrush" Color="#FF99A4" />
            <SolidColorBrush x:Key="StatusErrorBorderBrush" Color="#632D33" />

            <!-- Semantic Status: Neutral / Idle / Offline -->
            <SolidColorBrush x:Key="StatusNeutralBackgroundBrush" Color="#2D3035" />
            <SolidColorBrush x:Key="StatusNeutralForegroundBrush" Color="#C8CDD5" />
            <SolidColorBrush x:Key="StatusNeutralBorderBrush" Color="#3E434B" />

            <!-- Soft Accent Badge & Folder Icon Tint -->
            <SolidColorBrush x:Key="SoftAccentBackgroundBrush" Color="#1A334D" />
            <SolidColorBrush x:Key="SoftAccentForegroundBrush" Color="#60CDFF" />
            <SolidColorBrush x:Key="FolderIconBrush" Color="#F3C15A" />
            <SolidColorBrush x:Key="PathInsetBackgroundBrush" Color="#26282C" />
            <SolidColorBrush x:Key="BrowserToolbarBackgroundBrush" Color="#232529" />
            <SolidColorBrush x:Key="KeycapBackgroundBrush" Color="#303338" />
            <SolidColorBrush x:Key="KeycapBorderBrush" Color="#484D55" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- =========================================================================
         SPACING & GEOMETRY TOKENS
         ========================================================================= -->
    <Thickness x:Key="PageContentPadding">28,16,28,24</Thickness>
    <Thickness x:Key="CardDefaultPadding">20,16</Thickness>
    <Thickness x:Key="CardCompactPadding">16,12</Thickness>
    <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="InsetCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="PillCornerRadius">12</CornerRadius>

    <!-- =========================================================================
         TYPOGRAPHY HIERARCHY (Windows 11 Type Ramp)
         ========================================================================= -->
    <Style x:Key="PageTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="LineHeight" Value="32" />
    </Style>

    <Style x:Key="PageSubtitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SectionHeaderTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="CardTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="CardSubtitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="FieldLabelTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="CaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>

    <Style x:Key="MonoPathTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Segoe UI" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    </Style>

    <!-- =========================================================================
         SURFACE & CARD CONTAINERS
         ========================================================================= -->
    <Style x:Key="SurfaceCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="20,16" />
    </Style>

    <Style x:Key="CompactCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16,12" />
    </Style>

    <Style x:Key="InsetSurfaceStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource PathInsetBackgroundBrush}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="12,7" />
    </Style>

    <Style x:Key="HorizontalDividerStyle" TargetType="Rectangle">
        <Setter Property="Height" Value="1" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Fill" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
    </Style>

    <!-- =========================================================================
         UNIFIED BUTTON STYLES
         ========================================================================= -->
    <Style x:Key="PrimaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="SecondaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style x:Key="CompactSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="SubtleIconButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{ThemeResource StatusErrorForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource StatusErrorBorderBrush}" />
    </Style>

    <Style x:Key="TitleBarActionButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
        <Setter Property="Padding" Value="9,4" />
        <Setter Property="Height" Value="30" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style x:Key="BreadcrumbSegmentButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style x:Key="KeycapBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource KeycapBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource KeycapBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="7,2" />
    </Style>

    <!-- =========================================================================
         LISTVIEW ITEM CONTAINER (Clean Stretch, No Default Selection Clutter)
         ========================================================================= -->
    <Style x:Key="TaskCardListViewItemStyle" TargetType="ListViewItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="0,0,0,10" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="MinHeight" Value="0" />
    </Style>

</ResourceDictionary>
