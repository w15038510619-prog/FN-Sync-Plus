<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="FNSyncPlus.WinUI.Controls.StatusBadge"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid VerticalAlignment="Center">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ToneStates">
                <VisualState x:Name="Neutral">
                    <VisualState.Setters>
                        <Setter Target="PillBorder.Background" Value="{ThemeResource StatusNeutralBackgroundBrush}" />
                        <Setter Target="PillBorder.BorderBrush" Value="{ThemeResource StatusNeutralBorderBrush}" />
                        <Setter Target="PillDot.Fill" Value="{ThemeResource StatusNeutralForegroundBrush}" />
                        <Setter Target="PillText.Foreground" Value="{ThemeResource StatusNeutralForegroundBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Success">
                    <VisualState.Setters>
                        <Setter Target="PillBorder.Background" Value="{ThemeResource StatusSuccessBackgroundBrush}" />
                        <Setter Target="PillBorder.BorderBrush" Value="{ThemeResource StatusSuccessBorderBrush}" />
                        <Setter Target="PillDot.Fill" Value="{ThemeResource StatusSuccessForegroundBrush}" />
                        <Setter Target="PillText.Foreground" Value="{ThemeResource StatusSuccessForegroundBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Info">
                    <VisualState.Setters>
                        <Setter Target="PillBorder.Background" Value="{ThemeResource StatusInfoBackgroundBrush}" />
                        <Setter Target="PillBorder.BorderBrush" Value="{ThemeResource StatusInfoBorderBrush}" />
                        <Setter Target="PillDot.Fill" Value="{ThemeResource StatusInfoForegroundBrush}" />
                        <Setter Target="PillText.Foreground" Value="{ThemeResource StatusInfoForegroundBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Warning">
                    <VisualState.Setters>
                        <Setter Target="PillBorder.Background" Value="{ThemeResource StatusWarningBackgroundBrush}" />
                        <Setter Target="PillBorder.BorderBrush" Value="{ThemeResource StatusWarningBorderBrush}" />
                        <Setter Target="PillDot.Fill" Value="{ThemeResource StatusWarningForegroundBrush}" />
                        <Setter Target="PillText.Foreground" Value="{ThemeResource StatusWarningForegroundBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Error">
                    <VisualState.Setters>
                        <Setter Target="PillBorder.Background" Value="{ThemeResource StatusErrorBackgroundBrush}" />
                        <Setter Target="PillBorder.BorderBrush" Value="{ThemeResource StatusErrorBorderBrush}" />
                        <Setter Target="PillDot.Fill" Value="{ThemeResource StatusErrorForegroundBrush}" />
                        <Setter Target="PillText.Foreground" Value="{ThemeResource StatusErrorForegroundBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Accent">
                    <VisualState.Setters>
                        <Setter Target="PillBorder.Background" Value="{ThemeResource SoftAccentBackgroundBrush}" />
                        <Setter Target="PillBorder.BorderBrush" Value="{ThemeResource StatusInfoBorderBrush}" />
                        <Setter Target="PillDot.Fill" Value="{ThemeResource SoftAccentForegroundBrush}" />
                        <Setter Target="PillText.Foreground" Value="{ThemeResource SoftAccentForegroundBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Border
            x:Name="PillBorder"
            Background="{ThemeResource StatusNeutralBackgroundBrush}"
            BorderBrush="{ThemeResource StatusNeutralBorderBrush}"
            BorderThickness="1"
            CornerRadius="11"
            Padding="8,2"
            VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Ellipse
                    x:Name="PillDot"
                    Width="6"
                    Height="6"
                    Fill="{ThemeResource StatusNeutralForegroundBrush}"
                    VerticalAlignment="Center" />
                <TextBlock
                    x:Name="PillText"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource StatusNeutralForegroundBrush}"
                    TextTrimming="CharacterEllipsis"
                    MaxWidth="180"
                    VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
