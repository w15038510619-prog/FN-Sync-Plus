<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="FNSyncPlus.WinUI.Dialogs.TaskDetailsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:FNSyncPlus.WinUI.ViewModels"
    Title="任务详情与诊断中心"
    CloseButtonText="关闭"
    DefaultButton="Close"
    mc:Ignorable="d">

    <Grid MinWidth="620" MaxWidth="1050" MinHeight="440" MaxHeight="720" RowSpacing="10" Padding="0,4,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 1. TOP SUMMARY CARD -->
        <Border Grid.Row="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10">
            <StackPanel Spacing="6">
                <!-- Task Name & Storage Provider Header -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.TaskName, Mode=OneWay}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.StorageTypeDisplay, Mode=OneWay}" FontSize="10" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.TransferredSummaryText, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                </Grid>

                <!-- Source Path Row with Copy -->
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="65" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="源文件夹:" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SourceFolder, Mode=OneWay}" FontSize="11" FontFamily="Consolas" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind ViewModel.SourceFolder, Mode=OneWay}" />
                    <Button Grid.Column="2" Click="BtnCopySourcePath_Click" Style="{ThemeResource SubtleButtonStyle}" Padding="6,2" ToolTipService.ToolTip="复制源路径">
                        <FontIcon Glyph="&#xE8C8;" FontSize="11" />
                    </Button>
                </Grid>

                <!-- NAS Target Path Row with Copy -->
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="65" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="NAS 目标:" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.DestinationFolder, Mode=OneWay}" FontSize="11" FontFamily="Consolas" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind ViewModel.DestinationFolder, Mode=OneWay}" />
                    <Button Grid.Column="2" Click="BtnCopyDestPath_Click" Style="{ThemeResource SubtleButtonStyle}" Padding="6,2" ToolTipService.ToolTip="复制目标路径">
                        <FontIcon Glyph="&#xE8C8;" FontSize="11" />
                    </Button>
                </Grid>

                <!-- Metrics Capsules -->
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0">
                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="7,2">
                        <TextBlock Text="{x:Bind ViewModel.ScannedFilesText, Mode=OneWay}" FontSize="11" />
                    </Border>
                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="7,2">
                        <TextBlock Text="{x:Bind ViewModel.UploadedFilesText, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource SystemFillColorSuccessBrush}" FontWeight="SemiBold" />
                    </Border>
                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="7,2">
                        <TextBlock Text="{x:Bind ViewModel.UnchangedFilesText, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Border>
                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="7,2">
                        <TextBlock Text="{x:Bind ViewModel.LongNameFilesText, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontWeight="SemiBold" />
                    </Border>
                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="7,2">
                        <TextBlock Text="{x:Bind ViewModel.FailedFilesText, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource SystemFillColorCriticalBrush}" FontWeight="Bold" />
                    </Border>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 2. TABS: LONG NAME MAPPINGS & LOGS -->
        <TabView Grid.Row="1" CanDragTabs="False" CanReorderTabs="False">
            <TabView.TabStripFooter>
                <Border />
            </TabView.TabStripFooter>

            <!-- Tab 1: Long Name Mapping Table -->
            <TabViewItem Header="超长文件名别名映射清单" IsClosable="False">
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="0,0,8,8" Padding="12">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Status Notice Banner -->
                        <InfoBar Grid.Row="0" IsOpen="True" Severity="Informational" Message="{x:Bind ViewModel.ManifestStatusNotice, Mode=OneWay}" IsClosable="False" />

                        <!-- Table Header -->
                        <Grid Grid.Row="1" Background="{ThemeResource SubtleFillColorSecondaryBrush}" Padding="8,5" CornerRadius="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="2.5*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="50" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="类型" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="1" Text="原始超长相对路径" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="2" Text="NAS 物理存储安全别名" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="3" Text="UTF-8 字节" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="4" Text="SHA-256 哈希" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="5" Text="操作" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                        </Grid>

                        <!-- Empty State Notice -->
                        <Grid Grid.Row="2" Visibility="{x:Bind GetEmptyMappingsVisibility(ViewModel.HasLongNameMappings), Mode=OneWay}" MinHeight="160">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                                <FontIcon Glyph="&#xE73E;" FontSize="32" Foreground="{ThemeResource SystemFillColorSuccessBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="当前备份任务暂无超长文件名映射" FontSize="13" FontWeight="Medium" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="所有文件与目录名称均在 NAS UTF-8 255 字节限制内，100% 保持原名存储。" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <!-- Mapping List with Horizontal Scrolling -->
                        <ScrollViewer Grid.Row="2" Visibility="{x:Bind GetHasMappingsVisibility(ViewModel.HasLongNameMappings), Mode=OneWay}" HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollBarVisibility="Auto">
                            <ListView ItemsSource="{x:Bind ViewModel.LongNameMappings, Mode=OneWay}" SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LongNameMappingDisplayItem">
                                        <Grid Padding="6,5" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="2.5*" MinWidth="180" />
                                                <ColumnDefinition Width="2*" MinWidth="150" />
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="50" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="3" Padding="4,1" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind EntryType}" FontSize="10" />
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{x:Bind OriginalRel}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind OriginalRel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind StoredRel}" FontSize="11" FontFamily="Consolas" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind StoredRel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBlock Grid.Column="3" Text="{x:Bind Utf8BytesFormatted}" FontSize="11" Foreground="{ThemeResource SystemFillColorCriticalBrush}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="4" Text="{x:Bind Sha256}" FontSize="10" FontFamily="Consolas" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Sha256}" VerticalAlignment="Center" />
                                            <Button Grid.Column="5" Click="BtnCopyMappingItem_Click" Tag="{x:Bind OriginalRel}" Style="{ThemeResource SubtleButtonStyle}" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTipService.ToolTip="复制原始路径">
                                                <FontIcon Glyph="&#xE8C8;" FontSize="10" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </TabViewItem>

            <!-- Tab 2: Diagnostic Logs -->
            <TabViewItem Header="实时诊断与历史排障日志" IsClosable="False">
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="0,0,8,8" Padding="12">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Log Toolbar -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" PlaceholderText="搜索日志关键字..." Text="{x:Bind ViewModel.LogSearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="160" Margin="0,0,8,0" />
                            <ComboBox Grid.Column="1" SelectedIndex="{x:Bind ViewModel.SelectedLogLevelIndex, Mode=TwoWay}" Width="110" Margin="0,0,8,0">
                                <ComboBoxItem Content="全部日志" />
                                <ComboBoxItem Content="仅看错误" />
                                <ComboBoxItem Content="错误与警告" />
                            </ComboBox>
                            <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.StatusFeedbackMessage, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6">
                                <Button Click="BtnRefreshLogs_Click" Style="{ThemeResource SubtleButtonStyle}" Padding="8,4" ToolTipService.ToolTip="刷新日志">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE72C;" FontSize="11" />
                                        <TextBlock Text="刷新" FontSize="11" />
                                    </StackPanel>
                                </Button>
                                <Button Click="BtnCopyErrors_Click" Style="{ThemeResource SubtleButtonStyle}" Padding="8,4" ToolTipService.ToolTip="复制所有错误日志">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE8C8;" FontSize="11" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                        <TextBlock Text="复制错误" FontSize="11" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                    </StackPanel>
                                </Button>
                                <Button Click="BtnOpenLogDir_Click" Style="{ThemeResource SubtleButtonStyle}" Padding="8,4" ToolTipService.ToolTip="在文件资源管理器中打开日志目录">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE838;" FontSize="11" />
                                        <TextBlock Text="打开目录" FontSize="11" />
                                    </StackPanel>
                                </Button>
                                <Button Click="BtnExportDiag_Click" Style="{ThemeResource SubtleButtonStyle}" Padding="8,4" ToolTipService.ToolTip="导出单任务完整诊断包 (.zip)">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xEDE1;" FontSize="11" />
                                        <TextBlock Text="导出诊断包" FontSize="11" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Empty Logs State -->
                        <Grid Grid.Row="2" Visibility="{x:Bind GetEmptyLogsVisibility(ViewModel.HasLogs), Mode=OneWay}" MinHeight="160">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                                <FontIcon Glyph="&#xE9CE;" FontSize="32" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="暂无诊断日志记录" FontSize="13" FontWeight="Medium" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="任务在扫描、上传与校验过程中产生的详细日志将自动持久化至本地硬盘。" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <!-- Log Items List with horizontal scrolling, text wrapping, and selectable copyable text -->
                        <ScrollViewer Grid.Row="2" Visibility="{x:Bind GetHasLogsVisibility(ViewModel.HasLogs), Mode=OneWay}" 
                                      HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollBarVisibility="Auto">
                            <ListView ItemsSource="{x:Bind ViewModel.FilteredLogs, Mode=OneWay}" SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TaskLogDisplayItem">
                                        <Grid Padding="4,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{x:Bind FullFormattedText}" FontSize="11" FontFamily="Consolas, Segoe UI" TextWrapping="Wrap" IsTextSelectionEnabled="True" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <Button Grid.Column="1" Click="BtnCopySingleLog_Click" Tag="{x:Bind FullFormattedText}" Style="{ThemeResource SubtleButtonStyle}" Padding="4,2" VerticalAlignment="Top" ToolTipService.ToolTip="复制此条日志">
                                                <FontIcon Glyph="&#xE8C8;" FontSize="9" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </TabViewItem>
        </TabView>
    </Grid>
</ContentDialog>
