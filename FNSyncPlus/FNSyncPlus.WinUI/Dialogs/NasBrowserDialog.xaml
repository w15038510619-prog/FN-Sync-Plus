<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="FNSyncPlus.WinUI.Dialogs.NasBrowserDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:FNSyncPlus.WinUI.Controls"
    Title="选择飞牛 NAS 备份位置"
    PrimaryButtonText="选择此位置"
    CloseButtonText="取消"
    DefaultButton="Primary"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick"
    mc:Ignorable="d">

    <Grid Height="470" RowSpacing="10" Padding="0,4,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- DUAL-PANE EXPLORER -->
        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="176" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT PANE: CATEGORIES & SHARES -->
            <Border Grid.Column="0" Style="{StaticResource CompactCardStyle}" Padding="10">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="存储空间" Style="{StaticResource CaptionTextStyle}" FontWeight="SemiBold" Margin="4,2" />

                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Categories, Mode=OneWay}" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionMode="Single" SelectionChanged="CategoryList_SelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="6,6" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="{Binding IconGlyph}" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                        <TextBlock Text="{Binding Title}" ToolTipService.ToolTip="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Subtitle}" ToolTipService.ToolTip="{Binding Subtitle}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- RIGHT PANE: BREADCRUMBS, SEARCH, SUBFOLDERS OR GUIDANCE -->
            <Border Grid.Column="1" Style="{StaticResource CompactCardStyle}" Padding="12">
                <Grid>
                    <!-- View A: Guidance & Diagnostic View -->
                    <ScrollViewer Visibility="{x:Bind GetGuidanceVisibility(ViewModel.IsPersonalSpaceGuidanceActive), Mode=OneWay}" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="12" Margin="2">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Border Background="{ThemeResource StatusWarningBackgroundBrush}" BorderBrush="{ThemeResource StatusWarningBorderBrush}" BorderThickness="1" CornerRadius="6" Width="36" Height="36">
                                    <FontIcon Glyph="&#xE77B;" FontSize="17" Foreground="{ThemeResource StatusWarningForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{x:Bind ViewModel.PersonalSpaceTitle, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="FN Sync Plus 默认优先以「我的文件」为备份目标" Style="{StaticResource CaptionTextStyle}" />
                                </StackPanel>
                            </StackPanel>

                            <Border Style="{StaticResource InsetSurfaceStyle}" Padding="12,10">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="飞牛 fnOS 个人空间与 SMB 访问说明" FontWeight="SemiBold" FontSize="12" />
                                    <TextBlock Text="{x:Bind ViewModel.PersonalSpaceExplanation, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />

                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="8,6" Visibility="{x:Bind GetOfficialInfoVisibility(ViewModel.OfficialClientInfoText), Mode=OneWay}">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="飞牛官方客户端环境探测：" FontSize="11" FontWeight="SemiBold" />
                                            <TextBlock Text="{x:Bind ViewModel.OfficialClientInfoText, Mode=OneWay}" Style="{StaticResource MonoPathTextStyle}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource InsetSurfaceStyle}" Padding="12,10">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="开通个人专属 SMB 共享步骤" FontWeight="SemiBold" FontSize="12" />
                                    <TextBlock Text="{x:Bind ViewModel.PersonalSpaceSetupSteps, Mode=OneWay}" Style="{StaticResource MonoPathTextStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtCustomPersonalRoot" Grid.Column="0" PlaceholderText="输入路径（如 \\192.168.1.100\个人备份）" FontSize="12" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                    <Button Click="BtnApplyCustomPersonalRoot_Click" Style="{StaticResource PrimaryActionButtonStyle}">
                                        <TextBlock Text="验证并使用" FontSize="12" FontWeight="SemiBold" />
                                    </Button>
                                    <Button Click="BtnRefreshPersonalDetection_Click" Style="{StaticResource SecondaryActionButtonStyle}">
                                        <TextBlock Text="重新检测" FontSize="12" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{x:Bind ViewModel.CustomPathErrorMessage, Mode=OneWay}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" FontSize="11" TextWrapping="Wrap" Visibility="{x:Bind GetErrorNoticeVisibility(ViewModel.CustomPathErrorMessage), Mode=OneWay}" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- View B: Explorer View -->
                    <Grid Visibility="{x:Bind GetExplorerVisibility(ViewModel.IsPersonalSpaceGuidanceActive), Mode=OneWay}" RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Top Bar: Up + Breadcrumbs + Refresh + New Folder -->
                        <Grid Grid.Row="0" ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Click="BtnNavigateUp_Click" IsEnabled="{x:Bind ViewModel.CanNavigateUp, Mode=OneWay}" Style="{StaticResource SubtleIconButtonStyle}" VerticalAlignment="Center" ToolTipService.ToolTip="返回上一级目录">
                                <FontIcon Glyph="&#xE74A;" FontSize="12" />
                            </Button>

                            <BreadcrumbBar Grid.Column="1" ItemsSource="{x:Bind ViewModel.BreadcrumbItems, Mode=OneWay}" ItemClicked="BreadcrumbBar_ItemClicked" VerticalAlignment="Center">
                                <BreadcrumbBar.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Label}" FontSize="12" />
                                    </DataTemplate>
                                </BreadcrumbBar.ItemTemplate>
                            </BreadcrumbBar>

                            <Button Grid.Column="2" Click="BtnRefreshFolder_Click" Style="{StaticResource SubtleIconButtonStyle}" VerticalAlignment="Center" ToolTipService.ToolTip="刷新当前目录">
                                <FontIcon Glyph="&#xE72C;" FontSize="12" />
                            </Button>

                            <Button Grid.Column="3" Style="{StaticResource CompactSecondaryButtonStyle}" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon Glyph="&#xE8F4;" FontSize="11" />
                                    <TextBlock Text="新建" FontSize="11" />
                                </StackPanel>
                                <Button.Flyout>
                                    <Flyout x:Name="NewFolderFlyout">
                                        <StackPanel Spacing="8" Width="240">
                                            <TextBlock Text="新建子文件夹" FontWeight="SemiBold" FontSize="12" />
                                            <TextBox x:Name="TxtNewFolderName" PlaceholderText="输入文件夹名称" FontSize="12" />
                                            <TextBlock Text="{x:Bind ViewModel.LastErrorMessage, Mode=OneWay}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" FontSize="11" TextWrapping="Wrap" />
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" Click="BtnCancelNewFolder_Click" Style="{StaticResource SecondaryActionButtonStyle}" HorizontalAlignment="Stretch">
                                                    <TextBlock Text="取消" FontSize="11" />
                                                </Button>
                                                <Button Grid.Column="1" Click="BtnConfirmCreateFolder_Click" Style="{StaticResource PrimaryActionButtonStyle}" HorizontalAlignment="Stretch">
                                                    <TextBlock Text="创建" FontSize="11" FontWeight="SemiBold" />
                                                </Button>
                                            </Grid>
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>

                        <AutoSuggestBox Grid.Row="1" Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}" PlaceholderText="搜索子文件夹…" QueryIcon="Find" />

                        <ListView Grid.Row="2"
                                  ItemsSource="{x:Bind ViewModel.FolderItems, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.SelectedFolder, Mode=TwoWay}"
                                  HorizontalContentAlignment="Stretch"
                                  ScrollViewer.HorizontalScrollMode="Disabled"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  SelectionMode="Single"
                                  DoubleTapped="FolderList_DoubleTapped">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="6,6" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Grid.Column="0" Glyph="&#xE8B7;" FontSize="15" Foreground="{ThemeResource FolderIconBrush}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" ToolTipService.ToolTip="{Binding FullUncPath}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- BOTTOM STATUS & SECURITY EVALUATION -->
        <Border Grid.Row="1" Style="{StaticResource InsetSurfaceStyle}" Padding="12,8">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{x:Bind ViewModel.CurrentUncPath, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind ViewModel.CurrentUncPath, Mode=OneWay}" Style="{StaticResource MonoPathTextStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind ViewModel.SecurityDescription, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <controls:StatusBadge Text="{x:Bind ViewModel.PermissionStatusText, Mode=OneWay}" Tone="Success" />
                    <controls:StatusBadge Text="{x:Bind ViewModel.SecurityTitle, Mode=OneWay}" Tone="Neutral" MaxTextWidth="160" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ContentDialog>
