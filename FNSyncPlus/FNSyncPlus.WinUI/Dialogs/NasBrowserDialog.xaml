<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="FNSyncPlus.WinUI.Dialogs.NasBrowserDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:FNSyncPlus.WinUI.ViewModels"
    xmlns:core="using:FNSyncPlus.Core.Services"
    Title="浏览并选择飞牛 NAS 备份位置"
    PrimaryButtonText="确认选择此位置"
    CloseButtonText="取消"
    DefaultButton="Primary"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick"
    mc:Ignorable="d">

    <Grid Width="840" Height="520" RowSpacing="10" Padding="0,6,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- DUAL-PANE EXPLORER -->
        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT PANE: CATEGORIES & SHARES -->
            <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="存储空间分类" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="4,2" />

                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Categories, Mode=OneWay}" SelectionMode="Single" SelectionChanged="CategoryList_SelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="6,6" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="{Binding IconGlyph}" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- RIGHT PANE: BREADCRUMBS, SEARCH, SUBFOLDERS -->
            <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Top Bar: Breadcrumbs + Search + New Folder -->
                    <Grid Grid.Row="0" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- BreadcrumbBar -->
                        <BreadcrumbBar Grid.Column="0" ItemsSource="{x:Bind ViewModel.BreadcrumbItems, Mode=OneWay}" ItemClicked="BreadcrumbBar_ItemClicked" VerticalAlignment="Center">
                            <BreadcrumbBar.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Label}" FontSize="12" />
                                </DataTemplate>
                            </BreadcrumbBar.ItemTemplate>
                        </BreadcrumbBar>

                        <!-- Live Filter -->
                        <AutoSuggestBox Grid.Column="1" Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}" PlaceholderText="搜索子文件夹..." QueryIcon="Find" FontSize="11" VerticalAlignment="Center" />

                        <!-- New Folder Button with Flyout -->
                        <Button Grid.Column="2" Padding="8,6" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE8F4;" FontSize="11" />
                                <TextBlock Text="新建" FontSize="11" />
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout x:Name="NewFolderFlyout">
                                    <StackPanel Spacing="8" Width="220">
                                        <TextBlock Text="新建子文件夹" FontWeight="SemiBold" FontSize="12" />
                                        <TextBox x:Name="TxtNewFolderName" PlaceholderText="输入文件夹名称" FontSize="12" />
                                        <Button Click="BtnConfirmCreateFolder_Click" Style="{ThemeResource AccentButtonStyle}" HorizontalAlignment="Stretch">
                                            <TextBlock Text="创建" FontSize="11" />
                                        </Button>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>

                    <!-- Subfolders ListView -->
                    <ListView
                        Grid.Row="1"
                        ItemsSource="{x:Bind ViewModel.FolderItems, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.SelectedFolder, Mode=TwoWay}"
                        SelectionMode="Single"
                        DoubleTapped="FolderList_DoubleTapped">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="6,6" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE8B7;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{Binding RelativeSubPath}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" FontFamily="Consolas" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>

        <!-- BOTTOM STATUS & SECURITY EVALUATION -->
        <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{x:Bind ViewModel.CurrentUncPath, Mode=OneWay}" FontSize="11" FontFamily="Consolas" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind ViewModel.SecurityDescription, Mode=OneWay}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2">
                        <TextBlock Text="{x:Bind ViewModel.PermissionStatusText, Mode=OneWay}" FontSize="10" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                    </Border>
                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2">
                        <TextBlock Text="{x:Bind ViewModel.SecurityTitle, Mode=OneWay}" FontSize="10" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ContentDialog>
