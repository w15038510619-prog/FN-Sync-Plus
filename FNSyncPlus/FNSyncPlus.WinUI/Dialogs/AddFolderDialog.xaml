<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="FNSyncPlus.WinUI.Dialogs.AddFolderDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:FNSyncPlus.WinUI.ViewModels"
    Title="添加文件夹自动备份"
    PrimaryButtonText="立即创建并启动备份"
    CloseButtonText="取消"
    DefaultButton="Primary"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick"
    mc:Ignorable="d">

    <Grid Width="740" MaxHeight="580" RowSpacing="14" Padding="0,8,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 1. LOCAL FOLDERS PICKER -->
        <Border Grid.Row="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
            <Grid RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="第一步：选择本地源文件夹（支持单选或批量添加）" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Text="每个选中的本地文件夹将建立独立的备份规划与调度" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Button Grid.Column="1" Click="BtnAddLocalFolder_Click" Style="{ThemeResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8F4;" FontSize="12" />
                            <TextBlock Text="添加本地文件夹..." FontSize="12" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Selected Folders List -->
                <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.SelectedLocalFolders, Mode=OneWay}" MaxHeight="110" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="4,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE8B7;" FontSize="13" Margin="0,0,8,0" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding}" FontSize="12" FontFamily="Consolas, Segoe UI" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <Button Grid.Column="2" Click="BtnRemoveFolder_Click" Tag="{Binding}" Style="{ThemeResource SubtleButtonStyle}" Padding="6,2">
                                    <FontIcon Glyph="&#xE711;" FontSize="11" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!-- 2. NAS DESTINATION ROOT -->
        <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
            <StackPanel Spacing="10">
                <StackPanel Spacing="2">
                    <TextBlock Text="第二步：选择 NAS 私人备份根目录" FontSize="13" FontWeight="SemiBold" />
                    <TextBlock Text="默认优先定位至您的个人主目录，并自动执行权限与隐私安全评估" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{x:Bind ViewModel.NasDestinationRoot, Mode=TwoWay}" TextChanged="TxtNasRoot_TextChanged" PlaceholderText="例如: \\192.168.8.120\admin" FontFamily="Consolas, Segoe UI" FontSize="12" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Click="BtnBrowseNasRoot_Click" Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE753;" FontSize="12" />
                            <TextBlock Text="浏览 NAS 目录..." FontSize="12" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Security Evaluation InfoBar -->
                <InfoBar
                    IsOpen="True"
                    Severity="{x:Bind GetSecuritySeverity(ViewModel.IsTeamShareWarning), Mode=OneWay}"
                    Title="{x:Bind ViewModel.SecurityTitle, Mode=OneWay}"
                    Message="{x:Bind ViewModel.SecurityDescription, Mode=OneWay}"
                    IsClosable="False" />
            </StackPanel>
        </Border>

        <!-- 3. AUTO-PLAN PREVIEW -->
        <Border Grid.Row="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Spacing="2">
                    <TextBlock Text="第三步：自动化规划预览（同名文件夹自动创建与防覆盖冲突规划）" FontSize="13" FontWeight="SemiBold" />
                    <TextBlock Text="系统自动分析本地目录名并在 NAS 对应创建同名文件夹，如果存在外来冲突自动后缀区分" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.PlannedTasks, Mode=OneWay}" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="6,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="150" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding SourcePath}" FontSize="11" FontFamily="Consolas" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="{Binding FullTargetUnc}" FontSize="11" FontFamily="Consolas" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" Text="{Binding StatusText}" FontSize="11" Foreground="{ThemeResource SystemFillColorSuccessBrush}" HorizontalAlignment="Right" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</ContentDialog>
